@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .welcome-section {
        background-image: url('@Url.Content("~/Content/img/optica-bg.jpg")');
        background-size: cover;
        background-position: center;
        min-height: 65vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        position: relative;
        padding: 20px;
    }

    .welcome-overlay {
        background-color: rgba(0, 0, 0, 0.6);
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        max-width: 700px;
        width: 100%;
    }

    .welcome-overlay h1 {
        font-size: 2.8rem;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .welcome-overlay p {
        font-size: 1.2rem;
        margin-bottom: 20px;
    }

    .btn-verde {
        background-color: #A8E063;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 1rem;
        border-radius: 6px;
    }

    .btn-verde:hover {
        background-color: #8cd74a;
        color: white;
    }

    .section-divider {
        border-top: 5px solid #A8E063;
        width: 80%;
        margin: 40px auto;
    }
</style>

<section class="welcome-section">
    <div class="welcome-overlay">
        <h1 class="animate__animated animate__fadeInDown">Bienvenido/a a HD Ópticas</h1>
        <p class="animate__animated animate__fadeInUp">Cuidamos tu visión con la mejor tecnología y especialistas.</p>
        <a href="#servicios" class="btn btn-verde btn-lg animate__animated animate__fadeInUp">Ver Servicios</a>
    </div>
</section>

<div class="section-divider"></div>

<section id="servicios" class="container my-5">
    <h2 class="text-center mb-4">Nuestros Servicios</h2>

    
    <div class="row align-items-center mb-5 animate__animated animate__fadeInLeft">
        <div class="col-md-6 text-center">
            <img src="~/Content/Img/examen-visual.jpg" class="img-fluid rounded shadow-lg" alt="Servicio 1">
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold">Exámenes Visuales</h3>
            <p>Realizamos evaluaciones detalladas para diagnosticar y corregir problemas visuales.</p>
        </div>
    </div>

    <div class="section-divider"></div>

    
    <div class="row align-items-center mb-5 animate__animated animate__fadeInRight">
        <div class="col-md-6 order-md-2 text-center">
            <img src="~/Content/Img/lentes.jpg" class="img-fluid rounded shadow-lg" alt="Servicio 2">
        </div>
        <div class="col-md-6 order-md-1">
            <h3 class="fw-bold">Lentes</h3>
            <p>Contamos con una amplia variedad de lentes de alta calidad.</p>
        </div>
    </div>

   
    <div class="section-divider"></div>

    <div class="row align-items-center mb-5 animate__animated animate__fadeInLeft">
        <div class="col-md-6 text-center">
            <img src="~/Content/Img/especialista.jpg" class="img-fluid rounded shadow-lg" alt="Servicio 3">
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold">Cuidado y Salud Visual</h3>
            <p>Te brindamos asesoramiento y tratamientos especializados para el bienestar de tus ojos.</p>
        </div>
    </div>
</section>
