@model HDOpticasJAVS.Models.AjusteStockViewModel

@{
    ViewBag.Title = "Ajustar Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <strong>¡Éxito!</strong> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <strong>Error:</strong> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg w-100" style="max-width: 600px; background-color: #1f1f1f; border-radius: 15px; color: #F1E0C6;">
        <!-- ENCABEZADO VERDE CON LETRAS NEGRAS -->
        <div class="card-header text-center" style="background-color: #A8E063; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h4 class="fw-bold mb-0" style="color: black;">Ajustar Stock - @Model.Nombre_Producto</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("AjustarStock", "Inventario", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id_Producto)

                <div class="mb-3">
                    <label class="form-label">Stock Actual</label>
                    <input type="number" class="form-control bg-dark text-white border-secondary" value="@Model.StockActual" readonly />
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Cantidad, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Cantidad, new { @class = "form-control bg-dark text-white border-secondary", type = "number", min = "1" })
                    @Html.ValidationMessageFor(m => m.Cantidad, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Tipo, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Tipo, new SelectList(new[] {
                        new { Value = "Aumentar", Text = "Aumentar" },
                        new { Value = "Disminuir", Text = "Disminuir" }
                    }, "Value", "Text"), "Seleccione una opción", new { @class = "form-select bg-dark text-white border-secondary" })
                    @Html.ValidationMessageFor(m => m.Tipo, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Motivo, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.Motivo, new { @class = "form-control bg-dark text-white border-secondary", rows = 3, placeholder = "Describa el motivo del ajuste..." })
                    @Html.ValidationMessageFor(m => m.Motivo, "", new { @class = "text-danger" })
                </div>

                <div class="text-end">
                    <button type="submit" class="btn w-100 mb-2" style="background-color: #A8E063; color: black; font-weight: bold;">
                        Aplicar Ajuste
                    </button>
                    <a href="@Url.Action("Index", "Inventario")" class="btn w-100" style="background-color: #A8E063; color: black; font-weight: bold;">
                        Cancelar
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
