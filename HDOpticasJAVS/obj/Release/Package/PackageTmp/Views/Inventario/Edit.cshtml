@model HDOpticasJAVS.Models.ViewModels.Inventario

@{
    ViewBag.Title = "Editar producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2 class="text-white">@ViewBag.Title</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id_Producto)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Nombre del Producto</label>
                @Html.TextBoxFor(model => model.Nombre_Producto, new { @class = "form-control", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.Nombre_Producto, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <label>Código del Producto</label>
                @Html.TextBoxFor(model => model.Codigo_Producto, new { @class = "form-control", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.Codigo_Producto, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Stock</label>
                @Html.TextBoxFor(model => model.Stock, new { @class = "form-control", type = "number", min = "0", step = "1" })
                @Html.ValidationMessageFor(model => model.Stock, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <label>Precio</label>
                @Html.TextBoxFor(model => model.Precio, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
                @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Proveedor</label>
                @Html.TextBox("Nombre_Proveedor",
                    ((SelectList)ViewBag.Id_Proveedor)
                    .Cast<SelectListItem>()
                    .FirstOrDefault(p => int.Parse(p.Value) == Model.Id_Proveedor)?.Text,
                    new { @class = "form-control", @readonly = "readonly" })
                @Html.HiddenFor(model => model.Id_Proveedor)
            </div>
            <div class="col-md-6">
                <label>Descripción</label>
                @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Estado</label>
                @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <label>Usuario Creador</label>
                @Html.TextBoxFor(model => model.UsuarioCreador, new { @class = "form-control", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.UsuarioCreador, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Fecha de Creación</label>
                <input type="datetime-local" name="FechaCreacion" class="form-control"
                       value="@(Model.FechaCreacion != null && DateTime.TryParse(Model.FechaCreacion, out var dtCreacion) ? dtCreacion.ToString("yyyy-MM-ddTHH:mm") : "")" readonly />
                @Html.ValidationMessageFor(model => model.FechaCreacion, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <label>Usuario Modificador</label>
                @Html.EditorFor(model => model.UsuarioModificador, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UsuarioModificador, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label>Fecha de Modificación</label>
                <input type="datetime-local" name="FechaModificacion" class="form-control"
                       value="@(Model.FechaModificacion != null && DateTime.TryParse(Model.FechaModificacion, out var dtModificacion) ? dtModificacion.ToString("yyyy-MM-ddTHH:mm") : "")" />
                @Html.ValidationMessageFor(model => model.FechaModificacion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="text-end mb-5">
            <input type="submit" value="Guardar" class="btn btn-success" />
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
