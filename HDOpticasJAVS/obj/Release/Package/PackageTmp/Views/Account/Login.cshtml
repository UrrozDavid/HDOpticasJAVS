@{
    Layout = null;
    ViewBag.Title = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Iniciar Sesión - HD Ópticas JAVS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Roboto:wght@400;500&display=swap">
    <style>
        body {
            background-color: #FFFFFF;
            color: #FFFFFF;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Roboto', sans-serif;
        }

        .login-container {
            background-color: #1f1f1f;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
            width: 100%;
            max-width: 400px;
            text-align: center;
            border-top: 4px solid #A8E063;
        }

        h2 {
            font-family: 'Montserrat', sans-serif;
            color: #A8E063;
            margin-bottom: 1.5rem;
        }

        .form-control {
            background-color: #2a2a2a;
            color: #FFFFFF;
            border: 1px solid #555;
        }

            .form-control:focus {
                background-color: #2a2a2a;
                color: #FFFFFF;
                border-color: #A8E063;
                box-shadow: none;
            }

        .btn-primary {
            background-color: #A8E063;
            border-color: #A8E063;
            color: #000;
            font-weight: bold;
            transition: 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #7CB342;
                border-color: #7CB342;
                color: #000;
            }

        .login-options {
            margin-top: 1.5rem;
        }

            .login-options a {
                color: #A8E063;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .login-options a:hover {
                    text-decoration: underline;
                    color: #7CB342;
                }

        .alert-danger {
            background-color: #8B0000;
            color: #fff;
            border: none;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Iniciar Sesión</h2>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.Mensaje
            </div>
        }

        <form action="@Url.Action("Login", "Account")" method="post">
            <div class="mb-3">
                <input type="text" name="Usuario" class="form-control" placeholder="Usuario" required />
            </div>
            <div class="mb-3">
                <input type="password" name="Contrasenia" class="form-control" placeholder="Contraseña" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>

            <div class="login-options mt-3">
                <a href="@Url.Action("Recuperar", "Account")">¿Olvidaste tu contraseña?</a><br />
                <a href="@Url.Action("RegistroCliente", "Account")">Crear una cuenta</a>
            </div>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        <script>
            $(document).ready(function () {
                const motivo = "@Request.QueryString["motivo"]";
                if (motivo === "timeout") {
                    alert("Tu sesión se cerró automáticamente por inactividad.");
                }
            });
        </script>
    }
</body>
</html>
