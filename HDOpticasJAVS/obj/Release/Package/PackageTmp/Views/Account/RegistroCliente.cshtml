@{
    ViewBag.Title = "Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var generos = ViewBag.Generos as List<HDOpticasJAVS.Parametro>;
}

<div class="container mt-5 d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 700px; background-color: #1F1F1F; border-radius: 12px; color: white;">
        <div class="card-header text-center" style="background-color: #A8E063; color: black; border-top-left-radius: 12px; border-top-right-radius: 12px;">
            <h3 class="fw-bold" style="color: black;">Registro</h3>
        </div>

        <div class="card-body">
            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger">@ViewBag.Mensaje</div>
            }

            <form method="post" action="@Url.Action("GuardarCliente", "Account")">
                <div class="form-group mb-3">
                    <label>Cédula</label>
                    <input type="text" name="Cedula" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Nombre</label>
                    <input type="text" name="Nombre" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Primer apellido</label>
                    <input type="text" name="Apellido1" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Segundo apellido</label>
                    <input type="text" name="Apellido2" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Correo electrónico</label>
                    <input type="email" name="Correo" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Contraseña</label>
                    <input type="password" name="Contrasenia" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label>Fecha de nacimiento</label>
                    <input type="date" name="Fecha_Nacimiento" class="form-control" id="fechaNacimiento" required />
                </div>

                <div class="form-group mb-3">
                    <label>Edad</label>
                    <input type="number" name="Edad" class="form-control" id="edad" readonly />
                </div>

                <div class="form-group mb-3">
                    <label>Género</label>
                    <select name="Id_Genero" class="form-control" required>
                        <option value="">Seleccione...</option>
                        @foreach (var g in generos)
                        {
                            <option value="@g.Id_Parametro">@g.Nombre_Parametro</option>
                        }
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>Padecimiento</label>
                    <input type="text" name="Padecimiento" class="form-control" required />
                </div>

                <div class="form-group mb-4">
                    <label>Número de teléfono</label>
                    <input type="text" name="Numero_Telefono" class="form-control" required />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn w-100 fw-bold" style="background-color: #A8E063; color: black;">Registrarse</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById("fechaNacimiento").addEventListener("change", function () {
        let fechaNacimiento = new Date(this.value);
        let hoy = new Date();
        let edad = hoy.getFullYear() - fechaNacimiento.getFullYear();
        let mes = hoy.getMonth() - fechaNacimiento.getMonth();
        let dia = hoy.getDate() - fechaNacimiento.getDate();

        if (mes < 0 || (mes === 0 && dia < 0)) {
            edad--;
        }

        document.getElementById("edad").value = edad;
    });

    @if (TempData["Mensaje"] != null)
    {
        <text>alert("@TempData["Mensaje"]");</text>
    }
</script>

<style>
    label {
        color: #FFFFFF;
        font-family: "Poppins", sans-serif;
    }

    .form-control {
        background-color: #333333;
        color: white;
        border: 1px solid #A8E063;
    }

        .form-control::placeholder {
            color: #CCCCCC;
        }

        .form-control:focus {
            border-color: #A8E063;
            box-shadow: 0 0 0 0.2rem rgba(168, 224, 99, 0.25);
        }
</style>
