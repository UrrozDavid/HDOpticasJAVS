@model IEnumerable<HDOpticasJAVS.Cita>

<style>
    .pv-card {
        background: #1f1f1f;
        color: #fff;
        border-radius: 15px;
    }

    .pv-header {
        background: #A8E063;
        color: #000;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .pv-table {
        background: #222;
        color: #fff;
    }

        .pv-table thead {
            background: #333;
            color: #fff;
        }

        .pv-table th, .pv-table td {
            vertical-align: middle;
            padding: .55rem .7rem;
        }

        .pv-table tbody tr:nth-child(odd) {
            background: #1e1e1e;
        }

        .pv-table tbody tr:nth-child(even) {
            background: #202020;
        }
</style>

<div class="card shadow-lg pv-card">
    <div class="card-header pv-header">
        <h4 class="fw-bold m-0" style="font-family:'Poppins',sans-serif;">Citas</h4>
    </div>

    <div class="card-body" style="font-family:'Roboto',sans-serif;">
        <table class="table table-bordered table-hover pv-table mb-0">
            <thead>
                <tr>
                    <th style="width:16%;">Fecha</th>
                    <th style="width:14%;">Hora</th>
                    <th>Cliente</th>
                    <th style="width:24%;">Especialidad</th>
                    <th style="width:16%;">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cita in Model)
                {
                    var usuario = cita.Usuario;
                    var especialidad = cita.Parametro1;
                    <tr>
                        <td>@cita.Fecha_Cita.ToString("dd/MM/yyyy")</td>
                        <td>@cita.Hora_Cita</td>
                        <td>@(usuario?.Nombre + " " + usuario?.Apellido1 + " " + usuario?.Apellido2)</td>
                        <td>@especialidad.Nombre_Parametro</td>
                        <td>@(cita.Id_EstadoCita == 9 ? "Confirmada" : "Pendiente")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
