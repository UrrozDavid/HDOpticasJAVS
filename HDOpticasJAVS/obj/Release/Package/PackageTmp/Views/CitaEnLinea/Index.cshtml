@model IEnumerable<HDOpticasJAVS.Cita>

@{
    ViewBag.Title = "Citas Agendadas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 1100px; background: rgba(0, 0, 0, 0.75); color: #F1E0C6; border-radius: 15px;">
        <div class="card-header text-center" style="background-color: #1A73E8; color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            <div class="mb-3 text-end">
                @Html.ActionLink("Crear Nueva Cita", "Create", null, new { @class = "btn btn-success" })
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered">
                    <thead class="table-light text-dark" style="font-family: Raleway;">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Fecha_Cita)</th>
                            <th>@Html.DisplayNameFor(model => model.Hora_Cita)</th>
                            <th>@Html.DisplayNameFor(model => model.Empleado.Direccion)</th>
                            <th>Nombre cliente</th>
                            <th>Estado de la Cita</th>
                            <th>Especialidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Fecha_Cita)</td>
                                <td>@Html.DisplayFor(modelItem => item.Hora_Cita)</td>
                                <td>@Html.DisplayFor(modelItem => item.Empleado.Direccion)</td>
                                <td>@Html.DisplayFor(modelItem => item.Usuario.Nombre)</td>
                                <td>@Html.DisplayFor(modelItem => item.Parametro.Nombre_Parametro)</td>
                                <td>@Html.DisplayFor(modelItem => item.Parametro1.Nombre_Parametro)</td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id_Cita })" class="btn btn-warning btn-sm" title="Editar">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.Id_Cita })" class="btn btn-info btn-sm" title="Ver Detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @using (Html.BeginForm("DeleteConfirmed", "Cita", FormMethod.Post, new { onsubmit = "return confirm('¿Desea eliminar esta cita?');", style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.Id_Cita)
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>