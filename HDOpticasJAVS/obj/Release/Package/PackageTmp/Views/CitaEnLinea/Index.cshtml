@model IEnumerable<HDOpticasJAVS.Cita>

@{
    ViewBag.Title = "Citas Agendadas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Card + header */
    .pv-card {
        background: #1f1f1f;
        color: #fff;
        border-radius: 15px;
    }

    .pv-header {
        background: #A8E063;
        color: #000;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    /* Botones verdes */
    .pv-btn-green {
        background: #A8E063;
        color: #000 !important;
        border: none;
        border-radius: 8px;
        font-weight: 700;
    }

        .pv-btn-green:hover {
            filter: brightness(.95);
            color: #000 !important;
        }

    /* Tabla oscura */
    .pv-table {
        background: #222;
        color: #fff;
    }

        .pv-table thead {
            background: #333;
            color: #fff;
        }

        .pv-table th, .pv-table td {
            padding: .6rem .7rem;
            vertical-align: middle;
        }

        .pv-table tbody tr:nth-child(odd) {
            background: #1e1e1e;
        }

        .pv-table tbody tr:nth-child(even) {
            background: #202020;
        }

    /* Dropdown oscuro */
    .dropdown-menu-dark {
        background: #1f1f1f;
        color: #fff;
        border: 1px solid #333;
    }

        .dropdown-menu-dark .dropdown-item {
            color: #fff;
        }

            .dropdown-menu-dark .dropdown-item:hover {
                background: #333;
                color: #fff;
            }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100 pv-card" style="max-width: 1100px;">
        <div class="card-header text-center pv-header">
            <h2 class="fw-bold m-0" style="font-family:'Poppins',sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family:'Roboto',sans-serif;">


            @if (TempData["MensajeCitaError"] != null)
            {
                <div class="alert alert-danger text-center fw-bold mb-3" role="alert">
                    @TempData["MensajeCitaError"]
                </div>
            }

            @if (TempData["MensajeCitaExito"] != null)
            {
                <div class="alert alert-success text-center fw-bold mb-3" role="alert">
                    @TempData["MensajeCitaExito"]
                </div>
            }

            <div class="d-flex justify-content-between mb-3">
                <div>
                    @Html.ActionLink("Crear Nueva Cita", "Create", null, new { @class = "btn pv-btn-green" })
                </div>
                <div class="d-flex gap-2">
                    <button class="btn pv-btn-green" onclick="exportarTablaExcel()">Exportar a Excel</button>
                    <button class="btn pv-btn-green" onclick="exportarTablaPDF()">Exportar a PDF</button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="tablaCitas" class="table table-hover table-bordered pv-table mb-0">
                    <thead>
                        <tr>
                            <th>Fecha de la Cita</th>
                            <th>Hora de la Cita</th>
                            <th>Especialista</th>
                            <th>Nombre Cliente</th>
                            <th>Estado de la Cita</th>
                            <th>Especialidad</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Fecha_Cita.ToString("dd/MM/yyyy")</td>
                                <td>@Html.DisplayFor(modelItem => item.Hora_Cita)</td>
                                <td>@item.NombreEspecialista</td>
                                <td>@Html.DisplayFor(modelItem => item.Usuario.Nombre)</td>
                                <td>@Html.DisplayFor(modelItem => item.Parametro.Nombre_Parametro)</td>
                                <td>@Html.DisplayFor(modelItem => item.Parametro1.Nombre_Parametro)</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm pv-btn-green dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i> Opciones
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                            <li>
                                                <a class="dropdown-item" href="@Url.Action("Details", "CitaEnLinea", new { id = item.Id_Cita })">
                                                    <i class="bi bi-eye me-2"></i>Ver
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="@Url.Action("Edit", "CitaEnLinea", new { id = item.Id_Cita })">
                                                    <i class="bi bi-pencil me-2"></i>Editar
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                @using (Html.BeginForm("Delete", "CitaEnLinea", FormMethod.Post, new { onsubmit = "return confirm('¿Desea eliminar esta cita?');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("id", item.Id_Cita)
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>Eliminar
                                                    </button>
                                                }
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Scripts de exportación -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

<script>
    function exportarTablaExcel() {
        const tabla = document.getElementById("tablaCitas").cloneNode(true);

        const theadRow = tabla.querySelector("thead tr");
        if (theadRow) theadRow.removeChild(theadRow.lastElementChild);

        const filas = tabla.querySelectorAll("tbody tr");
        filas.forEach(fila => fila.removeChild(fila.lastElementChild));

        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.table_to_sheet(tabla);
        XLSX.utils.book_append_sheet(wb, ws, "Citas");

        XLSX.writeFile(wb, "Citas.xlsx");
    }

    async function exportarTablaPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        const tablaOriginal = document.getElementById("tablaCitas");
        const tablaClonada = tablaOriginal.cloneNode(true);

        tablaClonada.querySelector("thead tr").lastElementChild.remove();
        tablaClonada.querySelectorAll("tbody tr").forEach(row => row.lastElementChild.remove());

        doc.setFontSize(14);
        doc.text("Listado de Citas", 14, 15);

        doc.autoTable({
            html: tablaClonada,
            startY: 25,
            styles: { fontSize: 10 },
            headStyles: { fillColor: [26, 115, 232], textColor: [255, 255, 255] },
            alternateRowStyles: { fillColor: [240, 240, 240] }
        });

        doc.save("Citas.pdf");
    }
</script>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
