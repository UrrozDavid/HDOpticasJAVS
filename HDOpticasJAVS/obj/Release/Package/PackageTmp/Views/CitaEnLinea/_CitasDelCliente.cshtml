@model List<HDOpticasJAVS.Cita>

<table class="table table-bordered table-dark table-hover mt-3">
    <thead class="table-light text-dark">
        <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Especialidad</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No tienes citas agendadas.</td>
            </tr>
        }
        else
        {
            foreach (var cita in Model)
            {
                <tr>
                    <td>@cita.Fecha_Cita.ToString("yyyy-MM-dd")</td>
                    <td>@cita.Hora_Cita</td>
                    <td>@cita.Parametro1.Nombre_Parametro</td>
                    <td>@cita.Parametro.Nombre_Parametro</td>
                    <td>
                        <a href="@Url.Action("Editar", "CitaEnLinea", new { id = cita.Id_Cita })" class="btn btn-warning btn-sm">Editar</a>

                        @using (Html.BeginForm("CancelarCita", "CitaEnLinea", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("idCita", cita.Id_Cita)

                            <button class="btn btn-sm btn-danger"
                                    type="submit"
                                    data-fecha="@cita.Fecha_Cita.ToString("yyyy-MM-dd")"
                                    data-hora="@cita.Hora_Cita.ToString(@"hh\:mm")"
                                    onclick="return validarCancelar(this);">
                                Cancelar
                            </button>
                        }

                        <script>
                            function validarCancelar(btn) {
                                if (!confirm('¿Deseas cancelar esta cita?')) {
                                    return false;
                                }

                                const fechaStr = btn.getAttribute('data-fecha');
                                const horaStr = btn.getAttribute('data-hora');

                                if (!fechaStr || !horaStr) {
                                    alert("No se pudo validar la fecha y hora de la cita.");
                                    return false;
                                }

                                const citaDateTime = new Date(fechaStr + 'T' + horaStr + ':00'); 

                                const ahora = new Date();

                                const diffMs = citaDateTime - ahora;

                                const horas24 = 24 * 60 * 60 * 1000;

                                if (diffMs < horas24) {
                                    alert("No se puede cancelar la cita con menos de 24 horas de anticipación.");
                                    return false;
                                }

                                return true;
                            }
                        </script>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>