@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
    }

    .card-dark {
        background: #1a1a1a;
        color: #F1E0C6;
        height: 100%;
        min-height: 230px;
    }

    .card-wide {
       }

    @@media (max-width: 1200px) {
        .card-wide {
            grid-column: span 2;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .card-wide {
            grid-column: span 1;
        }
    }
</style>


<div class="container mt-4 dashboard-container">
    <h2 class="fw-bold text-center mb-4" style="font-family: 'Poppins', sans-serif; color: #A8E063;">@ViewBag.Title</h2>

    <div class="dashboard-grid">
        <!-- Estado General -->
        <div class="card shadow-lg p-4 rounded card-dark">
            <h5 class="mb-3" style="color: #A8E063;">Estado General</h5>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <div class="badge bg-success p-2">Ventas Activas</div>
                    <h4 class="ms-2">456</h4>
                </div>
                <div class="d-flex align-items-center">
                    <div class="badge bg-danger p-2">Deudas Pendientes</div>
                    <h4 class="ms-2">120</h4>
                </div>
            </div>
            <p>Resumen general de las operaciones actuales del negocio.</p>
            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width: 75%; background-color: #A8E063;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <!-- Notificaciones -->
        <div class="card shadow-lg p-4 rounded card-dark">
            <h5 class="mb-3" style="color: #A8E063;">Notificaciones</h5>
            <ul class="list-group list-group-flush">
                @foreach (var cita in (IEnumerable<HDOpticasJAVS.Cita>)ViewBag.CitasHoy)
                {
                    <li class="list-group-item bg-dark text-white d-flex justify-content-between align-items-center">
                        Cita hoy con @cita.Usuario.Nombre @cita.Usuario.Apellido1 (Esp.: @cita.NombreEspecialista)
                        <span class="badge bg-warning text-dark">Hoy</span>
                    </li>
                }
                @foreach (var cita in (IEnumerable<HDOpticasJAVS.Cita>)ViewBag.CitasProximas)
                {
                    <li class="list-group-item bg-dark text-white d-flex justify-content-between align-items-center">
                        Cita próxima con @cita.Usuario.Nombre @cita.Usuario.Apellido1 (Esp.: @cita.NombreEspecialista)
                        <span class="badge bg-info text-dark">@cita.Fecha_Cita.ToString("dd/MM")</span>
                    </li>
                }
                @foreach (var cita in (IEnumerable<HDOpticasJAVS.Cita>)ViewBag.CitasAtrasadas)
                {
                    <li class="list-group-item bg-dark text-white d-flex justify-content-between align-items-center">
                        ⚠️ Cita atrasada con @cita.Usuario.Nombre @cita.Usuario.Apellido1 (Esp.: @cita.NombreEspecialista)
                        <span class="badge bg-danger text-white">Vencida</span>
                    </li>
                }
            </ul>
        </div>

        <!-- Reportes Financieros -->
        <div class="card shadow-lg p-4 rounded card-dark">
            <h5 class="mb-3" style="color: #A8E063;">Reportes Financieros</h5>
            <div class="d-flex justify-content-between">
                <div>
                    <h3 class="fw-bold">₡@String.Format("{0:N0}", ViewBag.TotalIngresos)</h3>
                    <p>Total de Ventas</p>
                </div>
                <div>
                    <h3 class="fw-bold">₡1,120</h3>
                    <p>Total de Gastos</p>
                </div>
            </div>
            <div class="my-4">
                <canvas id="salesChart"></canvas>
            </div>
        </div>

        <!-- Desempeño de Ventas (Ocupando 3 columnas) -->
        <div class="card shadow-lg p-4 rounded card-dark card-wide">
            <h5 class="mb-3" style="color: #A8E063;">Desempeño de Ventas</h5>
            <div class="my-4">
                <canvas id="performanceChart"></canvas>
            </div>
        </div>

        <!-- Gastos vs Ingresos -->
        <div class="card shadow-lg p-4 rounded card-dark card-wide">
            <h5 class="mb-3" style="color: #A8E063;">Gastos vs Ingresos</h5>
            <div class="my-4">
                <canvas id="expensesChart"></canvas>
            </div>
        </div>

        <!-- Ventas por Método de Pago -->
        <div class="card shadow-lg p-4 rounded card-dark">
            <h5 class="mb-3" style="color: #A8E063;">Ventas por Método de Pago</h5>
            <div class="my-4">
                <canvas id="chartMetodoPago"></canvas>
            </div>
        </div>

        <!-- Productos más Vendidos -->
        <div class="card shadow-lg p-4 rounded card-dark">
            <h5 class="mb-3" style="color: #A8E063;">Productos más Vendidos</h5>
            <div class="my-4">
                <canvas id="chartProductos"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ventasMensuales = @Html.Raw(Json.Encode(ViewBag.VentasMensuales));
        const desempeñoMensual = @Html.Raw(Json.Encode(ViewBag.DesempeñoMensual));
        const totalIngresos = @ViewBag.TotalIngresos;
        const totalGastos = @ViewBag.TotalGastos;
        const ventasMetodoPago = @Html.Raw(Json.Encode(ViewBag.VentasPorMetodoPago));
        const productosMasVendidos = @Html.Raw(Json.Encode(ViewBag.ProductosMasVendidos));

        const ctx1 = document.getElementById('salesChart').getContext('2d');
        new Chart(ctx1, {
            type: 'line',
            data: {
                labels: ventasMensuales.map(v => ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][v.Mes - 1]),
                datasets: [{
                    label: 'Ventas Totales',
                    data: ventasMensuales.map(v => v.Total),
                    borderColor: '#A8E063',
                    tension: 0.3,
                    fill: false
                }]
            }
        });

        const ctx2 = document.getElementById('performanceChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: desempeñoMensual.map(v => ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][v.Mes - 1]),
                datasets: [{
                    label: 'Cantidad de Ventas',
                    data: desempeñoMensual.map(v => v.Cantidad),
                    backgroundColor: '#00B5E2'
                }]
            }
        });

        const ctx3 = document.getElementById('expensesChart').getContext('2d');
        new Chart(ctx3, {
            type: 'pie',
            data: {
                labels: ['Gastos', 'Ingresos'],
                datasets: [{
                    label: 'Gastos vs Ingresos',
                    data: [totalGastos, totalIngresos],
                    backgroundColor: ['#FF7043', '#A8E063'],
                    borderColor: '#fff',
                    borderWidth: 1
                }]
            }
        });

        const ctxMetodo = document.getElementById('chartMetodoPago').getContext('2d');
        new Chart(ctxMetodo, {
            type: 'bar',
            data: {
                labels: ventasMetodoPago.map(v => v.Metodo),
                datasets: [{
                    label: 'Total por Método de Pago',
                    data: ventasMetodoPago.map(v => v.Total),
                    backgroundColor: '#1A73E8'
                }]
            }
        });

        const ctxProductos = document.getElementById('chartProductos').getContext('2d');
        new Chart(ctxProductos, {
            type: 'bar',
            data: {
                labels: productosMasVendidos.map(p => p.Producto),
                datasets: [{
                    label: 'Cantidad Vendida',
                    data: productosMasVendidos.map(p => p.Cantidad),
                    backgroundColor: '#FF7043'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    legend: { position: 'top' },
                    title: { display: false }
                }
            }
        });
    </script>
}
