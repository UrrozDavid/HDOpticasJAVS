@model HDOpticasJAVS.Models.ViewModels.CampaniaMarketingViewModel
@{
    ViewBag.Title = "Campañas de Marketing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card-dark {
        background-color: #1f1f1f;
        color: #F1E0C6;
    }

    .header-verde {
        background-color: #A8E063;
        color: #000;
    }

    .btn-verde {
        background-color: #A8E063;
        border-color: #A8E063;
        color: #000;
        font-weight: 600;
    }

        .btn-verde:hover {
            background-color: #8DC44B;
            border-color: #8DC44B;
            color: #000;
        }

    .form-control-dark, .form-select-dark {
        background-color: #2c2c2c;
        color: #fff;
        border: 1px solid #555;
    }

        .form-control-dark::placeholder {
            color: #aaa;
        }

    .table-dark-custom {
        background-color: #2b2b2b;
        color: #fff;
    }

        .table-dark-custom thead th {
            background-color: #A8E063;
            color: #000;
        }

        .table-dark-custom tbody tr:hover {
            background-color: #383838;
        }

    .alert-success.custom {
        background-color: #A8E063;
        color: #000;
        border: none;
        font-weight: 600;
    }
</style>

<div class="card mt-4 shadow-lg rounded-4 card-dark">
    <div class="card-header text-center rounded-top-4 header-verde">
        <h4 class="fw-bold mb-0">Crear Campaña Promocional</h4>
    </div>

    <div class="card-body">

        @using (Html.BeginForm("EnviarCampania", "Marketing", FormMethod.Post))
        {
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Nombre_Campania)
                @Html.TextBoxFor(m => m.Nombre_Campania, new { @class = "form-control form-control-dark", placeholder = "Nombre de la campaña" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Descripcion)
                @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control form-control-dark", rows = 3, placeholder = "Descripción de la campaña" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Tipo)
                @Html.TextBoxFor(m => m.Tipo, new { @class = "form-control form-control-dark", placeholder = "Ej.: Promoción, Recordatorio, etc." })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Fecha_Inicio)
                @Html.TextBoxFor(m => m.Fecha_Inicio, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-dark", type = "date" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Fecha_Fin, "Fecha de Finalización")
                @Html.TextBoxFor(m => m.Fecha_Fin, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-dark", type = "date" })
                @Html.ValidationMessageFor(m => m.Fecha_Fin, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-4">
                @Html.LabelFor(m => m.Fecha_Programada, "Fecha Programada (opcional)")
                @Html.TextBoxFor(m => m.Fecha_Programada, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-dark", type = "date" })
            </div>

            <h5 class="fw-semibold mb-2" style="color:#A8E063;">Seleccionar Clientes:</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-dark-custom table-hover align-middle">
                    <thead class="text-center">
                        <tr>
                            <th>Seleccionar</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var total = (Model?.ClientesSeleccionados != null) ? Model.ClientesSeleccionados.Count : 0;
                        }
                        @if (total == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No hay clientes para mostrar.</td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < total; i++)
                            {
                                var correo = Model.ClientesSeleccionados[i].Correo;
                                <tr class="text-center">
                                    <td>
                                        @Html.HiddenFor(m => m.ClientesSeleccionados[i].Cedula)
                                        @Html.HiddenFor(m => m.ClientesSeleccionados[i].Correo)
                                        @Html.CheckBoxFor(m => m.ClientesSeleccionados[i].Seleccionado)
                                    </td>
                                    <td>@Model.ClientesSeleccionados[i].NombreCompleto</td>
                                    <td>@(string.IsNullOrWhiteSpace(correo) ? "—" : correo)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-verde">Enviar Campaña</button>
                <a href="@Url.Action("Historial", "Marketing")" class="btn btn-verde">Ver Historial de Campañas</a>
            </div>
        }

        @if (TempData["Mensaje"] != null)
        {
            var mensaje = TempData["Mensaje"].ToString();
            var esError = mensaje.Contains("⚠️");
            <div class="alert @(esError ? "alert-warning" : "alert-success custom") mt-3">
                @mensaje
            </div>
        }

    </div>
</div>
