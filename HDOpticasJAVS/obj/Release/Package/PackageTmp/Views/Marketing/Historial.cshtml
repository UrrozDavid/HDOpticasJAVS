@model List<HDOpticasJAVS.Models.ViewModels.CampaniaMarketingViewModel>
@{
    ViewBag.Title = "Historial de Campañas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .titulo-principal {
        background: #A8E063;
        color: #000;
        font-weight: 800;
        text-align: center;
        padding: 12px;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        margin-bottom: 0;
        border: 1px solid #2b2b2b;
        border-bottom: none;
        font-size: 1.35rem
    }

    .contenedor-principal {
        background: #121212;
        border: 1px solid #2b2b2b;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        padding: 16px;
        color: #F1E0C6
    }

    .btn-verde {
        background: #A8E063 !important;
        color: #000 !important;
        border: none !important;
        font-weight: 700;
        border-radius: 10px;
        padding: 8px 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 0 0 1px rgba(0,0,0,.15) inset;
        transition: transform .12s ease, filter .12s ease
    }

        .btn-verde:hover {
            transform: translateY(-1px);
            filter: brightness(1.05)
        }

        .btn-verde:active {
            transform: translateY(0)
        }

    .card.bg-dark {
        background: rgba(0,0,0,.85) !important;
        border: 1px solid #2b2b2b !important;
        border-radius: 12px !important
    }

    .badge-activa {
        background: #A8E063;
        color: #000;
        font-weight: 800
    }

    .badge-prog {
        background: #f7c744;
        color: #000;
        font-weight: 800
    }

    .badge-inact {
        background: #6c757d;
        color: #fff;
        font-weight: 800
    }
</style>

<div class="titulo-principal">📊 Historial de Campañas</div>

<div class="contenedor-principal">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info my-2">@TempData["Mensaje"]</div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success my-2">@TempData["Exito"]</div>
    }

    <div class="d-flex flex-wrap gap-2 mt-2">
        <a href="@Url.Action("Crear","Marketing")" class="btn-verde"><i class="fas fa-plus"></i> Crear Campaña Manual</a>
        <a href="@Url.Action("SegmentarClientes","Marketing")" class="btn-verde"><i class="fas fa-search"></i> Segmentar Clientes</a>
        <a href="@Url.Action("EnviarCampaniaSegmentada","Marketing")" class="btn-verde"><i class="fas fa-paper-plane"></i> Enviar a Lista Segmentada</a>
        <a href="@Url.Action("ConfigurarCriteriosRecurrentes","Marketing")" class="btn-verde"><i class="fas fa-cog"></i> Criterios Clientes Recurrentes</a>
        <a href="@Url.Action("LogErrores","Marketing")" class="btn-verde"><i class="fas fa-exclamation-triangle"></i> Ver Errores</a>
        <a href="@Url.Action("Tendencias","Marketing")" class="btn-verde"><i class="fas fa-chart-line"></i> Ver Análisis de Tendencias</a>
    </div>
</div>

<div class="row mt-3">
    @foreach (var item in Model)
    {
        var esManual = !string.IsNullOrWhiteSpace(item.Tipo) && item.Tipo.Trim().Equals("Manual", System.StringComparison.OrdinalIgnoreCase);
        var estaActiva = !string.IsNullOrWhiteSpace(item.Estado) && item.Estado.Trim().Equals("A", System.StringComparison.OrdinalIgnoreCase);

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card bg-dark text-white shadow-lg h-100 border-light rounded-4">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title" style="color:#A8E063;font-weight:800">@item.Nombre_Campania</h5>
                    <p class="card-text">@item.Descripcion</p>

                    <p class="mb-1">
                        <strong>Tipo:</strong> @item.Tipo <br />
                        <strong>Estado:</strong>
                        @{
                            var e = (item.Estado ?? "").Trim();
                            var estadoHtml =
                                e == "A" ? "<span class=\"badge badge-activa\">Activa</span>" :
                                e == "P" ? "<span class=\"badge badge-prog\">Programada</span>" :
                                e == "I" ? "<span class=\"badge badge-inact\">Inactiva</span>" :
                                           "<span class=\"badge badge-inact\">-</span>";
                        }
                        @Html.Raw(estadoHtml)
                    </p>

                    <p class="mb-1"><strong>Inicio:</strong> @item.Fecha_Inicio.ToShortDateString()</p>
                    <p class="mb-3"><strong>Programada:</strong> @(item.Fecha_Programada?.ToShortDateString() ?? "-")</p>

                    <div class="mt-auto d-flex flex-wrap gap-2">
                        <a href="@Url.Action("ExportarExcel", new { id = item.Id_Campania })" class="btn-verde btn-sm">📄 Exportar a Excel</a>
                        <a href="@Url.Action("ExportarPdf",  new { id = item.Id_Campania })" class="btn-verde btn-sm">📝 Exportar a PDF</a>
                        <a href="@Url.Action("EditarHistorial", new { id = item.Id_Campania })" class="btn-verde btn-sm">✏️ Editar</a>

                        @* Finalizar *@
                        @if (item.Estado != "I")
                        {
                            using (Html.BeginForm("Finalizar", "Marketing", FormMethod.Post, new { @class = "d-inline", data_ajax = "false" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", item.Id_Campania)
                                <button type="submit" class="btn-verde btn-sm" onclick="return confirm('¿Finalizar esta campaña?');">🛑 Finalizar</button>
                            }
                        }

                        @* Eliminar *@
                        @using (Html.BeginForm("Eliminar", "Marketing", FormMethod.Post, new { @class = "d-inline", data_ajax = "false" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", item.Id_Campania)
                            <button type="submit" class="btn-verde btn-sm" onclick="return confirm('¿Eliminar definitivamente esta campaña?');">🗑️ Eliminar</button>
                        }

                        @* Enviar Manual (form independiente + botón que lo referencia) *@
                        @if (esManual && estaActiva)
                        {
                            <!-- formulario oculto, NO anidado -->
                            <form id="form-enviar-@item.Id_Campania"
                                  action="@Url.Action("EnviarCampaniaManual","Marketing", new { id = item.Id_Campania })"
                                  method="post"
                                  class="d-none"
                                  data-ajax="false"
                                  novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id_Campania" />
                            </form>

                            <button type="submit"
                                    form="form-enviar-@item.Id_Campania"
                                    class="btn-verde btn-sm"
                                    onclick="if(!confirm('¿Enviar esta campaña manualmente?')){ return false; } this.disabled = true;">
                                📤 Enviar Manual
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-verde btn-sm" disabled title="Disponible para campañas MANUALES y ACTIVAS">📤 Enviar Manual</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
