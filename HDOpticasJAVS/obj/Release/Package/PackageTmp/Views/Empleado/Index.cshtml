@model List<HDOpticasJAVS.Models.EmpleadoViewModel>
@{
    ViewBag.Title = "Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* ====== Card / Header ====== */
    #empleado-index .card {
        background: #111 !important;
        border: 1px solid rgba(255,255,255,0.08);
    }

    #empleado-index .card-header {
        background-color: #A8E063 !important;
        color: #000 !important;
        border: none !important;
    }

        #empleado-index .card-header h2 {
            color: #000 !important;
            margin: 0;
            text-shadow: none;
        }

    /* ====== Formulario de búsqueda ====== */
    #empleado-index .form-control {
        background-color: #1a1a1a !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,0.2) !important;
    }

        #empleado-index .form-control::placeholder {
            color: #bfbfbf !important;
        }

    /* Botones primarios/secundarios/éxito coherentes */
    #empleado-index .btn-primary {
        background-color: #A8E063 !important;
        border-color: #A8E063 !important;
        color: #000 !important;
    }

        #empleado-index .btn-primary:hover {
            background-color: #91cc56 !important;
            border-color: #91cc56 !important;
        }

    #empleado-index .btn-success {
        background-color: #A8E063 !important;
        border-color: #A8E063 !important;
        color: #000 !important;
    }

        #empleado-index .btn-success:hover {
            background-color: #91cc56 !important;
            border-color: #91cc56 !important;
        }

    #empleado-index .btn-secondary {
        background-color: #444 !important;
        border-color: #444 !important;
        color: #fff !important;
    }

        #empleado-index .btn-secondary:hover {
            background-color: #555 !important;
            border-color: #555 !important;
        }

    /* ====== Tabla dark con hover y thead legible ====== */
    #empleado-index .table {
        border-color: rgba(255,255,255,0.08) !important;
    }

        #empleado-index .table thead th {
            background: #1f1f1f !important; /* o #fff si prefieres claro */
            color: #ddd !important;
            border-color: rgba(255,255,255,0.12) !important;
        }

    #empleado-index .table-dark > :not(caption) > * > * {
        background-color: #15191d !important;
        color: #e6e6e6 !important;
        border-color: rgba(255,255,255,0.08) !important;
    }

    #empleado-index .table-dark.table-hover tbody tr:hover > td,
    #empleado-index .table-dark.table-hover tbody tr:hover > th {
        background-color: #22272c !important;
        color: #fff !important;
    }

    /* ====== Badges estado ====== */
    #empleado-index .badge.bg-success {
        background-color: #2ecc71 !important;
    }

    #empleado-index .badge.bg-danger {
        background-color: #e74c3c !important;
    }

    #empleado-index .badge.bg-secondary {
        background-color: #6c757d !important;
    }

    /* ====== Dropdown de acciones ====== */
    #empleado-index .btn-group .btn.dropdown-toggle {
        background-color: #2b2b2b !important;
        border-color: rgba(255,255,255,0.15) !important;
        color: #fff !important;
    }

        #empleado-index .btn-group .btn.dropdown-toggle:hover {
            background-color: #3a3a3a !important;
            border-color: rgba(255,255,255,0.25) !important;
        }

    #empleado-index .dropdown-menu-dark {
        background-color: #1c1f23 !important;
        border-color: rgba(255,255,255,0.1) !important;
    }

    #empleado-index .dropdown-item {
        color: #e6e6e6 !important;
    }

        #empleado-index .dropdown-item:hover {
            background: #2a2f34 !important;
            color: #fff !important;
        }

        #empleado-index .dropdown-item.text-danger {
            color: #ff6b6b !important;
        }

    /* ====== Alertas ====== */
    #empleado-index .alert-warning {
        background-color: #3a2f00 !important;
        color: #ffe08a !important;
        border-color: #6b5700 !important;
    }
</style>


<div id="empleado-index" class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg" style="max-width: 1000px; width: 100%; background: #111; color: #F1E0C6; border-radius: 20px;">
        <div class="card-header text-center" style="color: white; border-top-left-radius: 20px; border-top-right-radius: 20px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">


            @using (Html.BeginForm("Buscar", "Empleado", FormMethod.Get))
            {
                <div class="form-group row">
                    <div class="col-md-8">
                        <input type="text" name="criterio" class="form-control" placeholder="Buscar por nombre, cédula, etc." />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Buscar</button>
                    </div>
                    <div class="col-md-2 mt-2 mt-md-0">
                        <a href="@Url.Action("Index", "Empleado")" class="btn btn-secondary w-100">Ver Todos</a>
                    </div>
                </div>
            }

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-warning mt-2">@ViewBag.Mensaje</div>
            }

            <div class="d-flex justify-content-between mt-3">
                <div>
                    <a href="@Url.Action("Informe", "Empleado")" class="btn btn-success">Informes</a>
                </div>
                <div>
                    <a href="@Url.Action("CrearEmpleado", "Empleado")" class="btn btn-primary">Crear Empleado</a>
                </div>
            </div>

            <table class="table table-dark table-hover table-bordered rounded mt-4">
                <thead class="table-light text-dark">
                    <tr class="text-center">
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Direccion</th>
                        <th>Numero de telefono</th>
                        <th>Contacto de emergencia</th>
                        <th>Placa de vehiculo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Cedula</td>
                            <td>@usuario.Nombre @usuario.Apellido1 @usuario.Apellido2</td>
                            <td>@usuario.Correo</td>
                            <td>@usuario.Direccion</td>
                            <td>@usuario.NumeroTelefono</td>
                            <td>@usuario.ContactoEmergencia</td>
                            <td>@usuario.Placa_Vehiculo</td>
                            <td>
                                @if (usuario.Estado == "A")
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else if (usuario.Estado == "I")
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Desconocido</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i> Opciones
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Detalles", "Empleado", new { cedula = usuario.Cedula })">
                                                <i class="bi bi-eye me-2"></i>Ver
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Editar", "Empleado", new { cedula = usuario.Cedula })">
                                                <i class="bi bi-pencil me-2"></i>Editar
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            @using (Html.BeginForm("Eliminar", "Empleado", FormMethod.Post, new { onsubmit = "return confirm('¿Desea eliminar este empleado?');" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("cedula", usuario.Cedula)
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-person-x-fill me-2"></i>Desactivar
                                                </button>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
