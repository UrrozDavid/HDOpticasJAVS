@model List<HDOpticasJAVS.Models.EmpleadoViewModel>

@{
    Layout = null;
}

<style>
    body {
        font-family: "Segoe UI", sans-serif;
        font-size: 12px;
        color: #fff;
        background-color: #111;
        margin: 0;
        padding: 20px;
    }

    h2 {
        font-family: "Poppins", sans-serif;
        font-size: 20px;
        background-color: #A8E063;
        color: #000;
        padding: 10px;
        text-align: center;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    table {
        border-collapse: collapse;
        width: 100%;
        font-size: 12px;
    }

    thead th {
        background-color: #1f1f1f;
        color: #ddd;
        font-weight: bold;
        padding: 8px;
        border: 1px solid rgba(255,255,255,0.15);
        text-align: center;
    }

    tbody td {
        padding: 8px;
        border: 1px solid rgba(255,255,255,0.08);
        text-align: center;
    }

    tbody tr:nth-child(even) {
        background-color: #15191d;
    }

    tbody tr:nth-child(odd) {
        background-color: #1b1f23;
    }

    /* Estado como "badge" simplificado para PDF */
    .estado-activo {
        color: #000;
        background: #A8E063;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
    }

    .estado-inactivo {
        color: #fff;
        background: #e74c3c;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
    }
</style>

<h2>Informe de Empleados</h2>
<table>
    <thead>
        <tr>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Primer Apellido</th>
            <th>Segundo Apellido</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Cedula</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido1</td>
                <td>@item.Apellido2</td>
                <td>@item.Correo</td>
                <td>@item.Rol</td>
                <td>
                    @if (item.Estado == "A")
                    {
                        <span class="estado-activo">Activo</span>
                    }
                    else if (item.Estado == "I")
                    {
                        <span class="estado-inactivo">Inactivo</span>
                    }
                    else
                    {
                        @item.Estado
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
