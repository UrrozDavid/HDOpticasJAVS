@model HDOpticasJAVS.Models.EmpleadoViewModel
@{
    ViewBag.Title = "Perfil del Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ====== Card / Header ====== */
    #empleado-perfil .card {
        background: #111 !important;
        color: #F1E0C6;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 15px;
    }

    #empleado-perfil .card-header {
        background: #A8E063 !important;
        color: #000 !important;
        border: none !important;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

        #empleado-perfil .card-header h2 {
            margin: 0;
            font-family: 'Poppins',sans-serif;
        }

    /* ====== Bloque de datos ====== */
    #empleado-perfil dl {
        margin-bottom: 0;
    }

    #empleado-perfil dt {
        color: #A8E063;
        font-weight: 600;
        border-bottom: 1px solid rgba(255,255,255,.08);
        padding: 6px 0;
    }

    #empleado-perfil dd {
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,.05);
        padding: 6px 0;
    }

    /* ====== Formulario solicitud ====== */
    #empleado-perfil .form-control,
    #empleado-perfil textarea {
        background: #1a1a1a !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,.2) !important;
    }

        #empleado-perfil .form-control::placeholder {
            color: #bfbfbf !important;
        }

    #empleado-perfil .btn-primary {
        background: #A8E063 !important;
        border-color: #A8E063 !important;
        color: #000 !important;
        font-weight: 600;
    }

        #empleado-perfil .btn-primary:hover {
            background: #91cc56 !important;
            border-color: #91cc56 !important;
        }

    /* Alert info en dark */
    #empleado-perfil .alert-info {
        background: #0f2a3a !important;
        color: #bfeaff !important;
        border-color: #11435e !important;
    }

    /* Espaciados compactos */
    #empleado-perfil .card-body {
        padding: 24px;
    }

    #empleado-perfil .inner-card {
        background: #15191d;
        border-radius: 12px;
    }
</style>

<div id="empleado-perfil" class="container d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow-lg text-white" style="max-width:800px; width:100%;">
        <div class="card-header text-center">
            <h2>@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family:'Roboto',sans-serif;">
            <div class="inner-card p-4">
                <dl class="row">
                    <dt class="col-sm-4">Nombre:</dt>
                    <dd class="col-sm-8">@Model.Nombre @Model.Apellido1 @Model.Apellido2</dd>

                    <dt class="col-sm-4">Cédula:</dt>
                    <dd class="col-sm-8">@Model.Cedula</dd>

                    <dt class="col-sm-4">Correo:</dt>
                    <dd class="col-sm-8">@Model.Correo</dd>

                    <dt class="col-sm-4">Teléfono:</dt>
                    <dd class="col-sm-8">@Model.NumeroTelefono</dd>

                    <dt class="col-sm-4">Dirección:</dt>
                    <dd class="col-sm-8">@Model.Direccion</dd>

                    <dt class="col-sm-4">Placa Vehículo:</dt>
                    <dd class="col-sm-8">@Model.Placa_Vehiculo</dd>
                </dl>

                <hr />

                <h4 class="mt-3 mb-2" style="color:#A8E063;">Solicitar Actualización de Datos</h4>

                @using (Html.BeginForm("EnviarCorreo", "Empleado", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>Mensaje adicional:</label>
                        <textarea name="mensajeAdicional" class="form-control" rows="4" placeholder="Escribe un mensaje opcional..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Enviar Solicitud</button>
                }

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-info mt-3 alert-dismissible fade show" role="alert">
                        @TempData["Mensaje"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
