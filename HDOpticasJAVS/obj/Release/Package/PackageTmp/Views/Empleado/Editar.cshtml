@model HDOpticasJAVS.Empleado

@{
    ViewBag.Title = "Editar Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool estaInactivo = Model.Estado == "I";
    var atributos = new Dictionary<string, object> { { "class", "form-control" } };

    if (estaInactivo)
    {
        atributos.Add("disabled", "disabled");
    }
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header text-center bg-primary text-white">
                    <h2 class="titulo">Editar Empleado</h2>
                </div>
                <div class="card-body bg-dark">
                    @Html.AntiForgeryToken()
                    @using (Html.BeginForm("Editar", "Empleado", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Cedula)

                        <div class="form-group">
                            <label>Nombre:</label>
                            @Html.TextBoxFor(model => model.Usuario.Nombre, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label>Primer Apellido:</label>
                            @Html.TextBoxFor(model => model.Usuario.Apellido1, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label>Segundo Apellido:</label>
                            @Html.TextBoxFor(model => model.Usuario.Apellido2, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label>Correo:</label>
                            @Html.TextBoxFor(model => model.Usuario.Correo, new { @class = "form-control", type = "email" })
                        </div>
                        <div class="form-group">
                            <label>Direccion:</label>
                            @Html.TextBoxFor(model => model.Direccion, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label>Numero de telefono:</label>
                            @Html.TextBoxFor(model => model.Numero_Telefono, new { @class = "form-control", type = "num" })
                        </div>
                        <div class="form-group">
                            <label>Contacto de emergencia:</label>
                            @Html.TextBoxFor(model => model.Contacto_Emergencia, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label>Placa del vehiculo:</label>
                            @Html.TextBoxFor(model => model.Placa_Vehiculo, new { @class = "form-control" })
                        </div>


                        <a href="@Url.Action("Index", "Empleado")" class="btn btn-secondary mt-3">Volver</a>

                        <button type="submit" class="btn btn-warning btn-block">Actualizar</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>