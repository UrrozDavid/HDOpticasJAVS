@{
    ViewBag.Title = "Crear Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ====== Encabezado verde ====== */
    #empleado-create .card-header {
        background-color: #A8E063 !important;
        color: #000 !important;
        border: none !important;
    }

        #empleado-create .card-header h2 {
            color: #000 !important;
            margin: 0;
            text-shadow: none;
        }

    /* ====== Fondo y bordes ====== */
    #empleado-create .card {
        background: #111 !important;
        border: 1px solid rgba(255,255,255,0.08);
    }

    /* ====== Inputs y selects oscuros ====== */
    #empleado-create .form-control,
    #empleado-create textarea,
    #empleado-create select {
        background-color: #1a1a1a !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,0.2) !important;
    }

        #empleado-create .form-control::placeholder {
            color: #bfbfbf !important;
        }

    /* ====== Botones ====== */
    #empleado-create .btn-success {
        background-color: #A8E063 !important;
        border-color: #A8E063 !important;
        color: #000 !important;
    }

        #empleado-create .btn-success:hover {
            background-color: #91cc56 !important;
            border-color: #91cc56 !important;
        }

    #empleado-create .btn-secondary {
        background-color: #444 !important;
        border-color: #444 !important;
        color: #fff !important;
    }

        #empleado-create .btn-secondary:hover {
            background-color: #555 !important;
            border-color: #555 !important;
        }

    /* ====== Etiquetas ====== */
    #empleado-create label {
        font-weight: 600;
        color: #A8E063;
    }
</style>


<div id="empleado-create" class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg" style="max-width: 900px; width: 100%; background: #111; color: #F1E0C6; border-radius: 15px;">
        <div class="card-header text-center" style="color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family: 'Roboto', sans-serif;">

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger">@ViewBag.Mensaje</div>
            }

            @using (Html.BeginForm("GuardarEmpleado", "Empleado", FormMethod.Post, new { @class = "row g-3", @autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                <div class="col-md-6">
                    <label>Cédula</label>
                    <input type="text" name="Cedula" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label>Correo</label>
                    <input type="email" name="Correo" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label>Nombre</label>
                    <input type="text" name="Nombre" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label>Primer Apellido</label>
                    <input type="text" name="Apellido1" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label>Segundo Apellido</label>
                    <input type="text" name="Apellido2" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label>Fecha de Nacimiento</label>
                    <input type="date" name="FechaNacimiento" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label>Rol</label>
                    @Html.DropDownList("Id_Rol", ViewBag.Roles as SelectList, "-- Seleccionar --", new { @class = "form-control", required = "required" })
                </div>

                <div class="col-12">
                    <label>Dirección</label>
                    <textarea name="Direccion" class="form-control" rows="2" required></textarea>
                </div>

                <div class="col-md-6">
                    <label>Placa del Vehículo</label>
                    <input type="text" name="Placa_Vehiculo" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Teléfono</label>
                    <input type="tel" name="Numero_Telefono" class="form-control" required />
                </div>

                <div class="col-12">
                    <label>Contacto de Emergencia</label>
                    <input type="text" name="Contacto_Emergencia" class="form-control" required />
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-success">Guardar Empleado</button>
                    <a href="@Url.Action("Index", "Empleado")" class="btn btn-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>