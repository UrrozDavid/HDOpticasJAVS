@model HDOpticasJAVS.Usuario

@{
    ViewBag.Title = "Detalles de Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 1000px; background: rgba(0, 0, 0, 0.85); color: #F1E0C6; border-radius: 15px;">
        <div class="card-header text-center" style="background-color: #1A73E8; color: white;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Empleado.Cedula)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cedula)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-4">Correo</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Correo)</dd>

                <dt class="col-sm-4">Direccion</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Empleado.Direccion)</dd>

                <dt class="col-sm-4">Numero de telefono</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Empleado.Numero_Telefono)</dd>

                <dt class="col-sm-4">Contacto de emergencia</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Empleado.Contacto_Emergencia)</dd>

                <dt class="col-sm-4">Placa del vehiculo</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Empleado.Placa_Vehiculo)</dd>

                <dt class="col-sm-4">Rol</dt>
                <dd class="col-sm-8">@((Model.Parametro != null) ? Model.Parametro.Nombre_Parametro : "Sin rol")</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@((Model.Estado == "A") ? "Activo" : "Inactivo")</dd>
            </dl>

            <div class="text-end mt-4">
                <a href="@Url.Action("Index", "Empleado")" class="btn btn-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>

