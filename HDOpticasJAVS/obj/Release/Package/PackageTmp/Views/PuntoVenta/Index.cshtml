@model IEnumerable<HDOpticasJAVS.PuntoVenta>

@{
    ViewBag.Title = "Administración Punto de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 2400px; background: rgba(0, 0, 0, 0.75); color: #F1E0C6; border-radius: 15px;">

        <div class="card-header text-center" style="background-color: #1A73E8; color: white;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="text-end mb-3">
                <a href="@Url.Action("Create")" class="btn btn-success">Registrar Venta</a>
            </div>

            <table class="table table-dark table-hover table-bordered">
                <thead class="table-light text-dark" style="font-family: Raleway;">
                    <tr>
                        <th>Producto</th>
                        <th>Cliente</th>
                        <th>Cantidad</th>
                        <th>Precio unitario y subtotal por producto</th>
                        <th>Subtotal</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Método de Pago</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody style="font-family: Roboto;">
                    @foreach (var item in Model.Where(x => x.Estado == "A"))
                    {
                        <tr>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var detalle in item.DetalleVenta)
                                    {
                                        <li>- @detalle.Inventario.Nombre_Producto</li>
                                    }
                                </ul>
                            </td>
                            <td>@item.Cliente.Usuario.Nombre @item.Cliente.Usuario.Apellido1 @item.Cliente.Usuario.Apellido2</td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var detalle in item.DetalleVenta)
                                    {
                                        <li>- @detalle.Cantidad</li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var detalle in item.DetalleVenta)
                                    {
                                        <li>- @detalle.Inventario.Nombre_Producto (x @detalle.Cantidad) -> ₡@detalle.Subtotal</li>
                                    }
                                </ul>
                            </td>
                            <td>₡@item.Subtotal</td>
                            <td>₡@item.IVA</td>
                            <td>₡@item.Total</td>
                            <td>@item.Parametro.Nombre_Parametro</td>
                            <td>@($"{item.Fecha_Venta:dd/MM/yyyy}")</td>
                            <td>@($"{item.Hora_Venta:hh\\:mm\\:ss}")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = item.Id_Venta })" class="btn btn-warning btn-sm" title="Editar"><i class="fas fa-pen"></i></a>
                                <a href="@Url.Action("Details", new { id = item.Id_Venta })" class="btn btn-info btn-sm" title="Ver Detalles"><i class="fas fa-eye"></i></a>
                                @using (Html.BeginForm("DeleteConfirmed", "PuntoVenta", FormMethod.Post, new { onsubmit = "return confirm('¿Desea eliminar esta venta?');", style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", item.Id_Venta)
                                    <button type="submit" class="btn btn-danger btn-sm" title="Eliminar"><i class="fas fa-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>