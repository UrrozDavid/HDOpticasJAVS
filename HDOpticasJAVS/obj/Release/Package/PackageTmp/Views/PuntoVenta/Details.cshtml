@model HDOpticasJAVS.PuntoVenta

@{
    ViewBag.Title = "Detalles de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 1100px; background-color: #1f1f1f; color: white; border-radius: 15px;">

        <!-- Encabezado -->
        <div class="card-header text-center" style="background-color: #A8E063; color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <!-- Cuerpo -->
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">

            <!-- Datos principales -->
            <dl class="row">
                <dt class="col-sm-4 text-white">Cliente</dt>
                <dd class="col-sm-8">
                    @Model.Cliente.Usuario.Nombre @Model.Cliente.Usuario.Apellido1 @Model.Cliente.Usuario.Apellido2
                </dd>

                <dt class="col-sm-4 text-white">Método de Pago</dt>
                <dd class="col-sm-8">@Model.Parametro.Nombre_Parametro</dd>

                <dt class="col-sm-4 text-white">Fecha</dt>
                <dd class="col-sm-8">@($"{Model.Fecha_Venta:dd/MM/yyyy}")</dd>

                <dt class="col-sm-4 text-white">Hora</dt>
                <dd class="col-sm-8">@Model.Hora_Venta</dd>
            </dl>

            <hr class="border-light" />

            <!-- Detalle de productos -->
            <h5 class="text-success mb-3"><i class="fa fa-box"></i> Detalle de Productos</h5>
            <table class="table table-dark table-hover table-bordered text-white">
                <thead style="background-color: #A8E063; color: white;">
                    <tr>
                        <th>Producto</th>
                        <th>Precio Unitario</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model.DetalleVenta)
                    {
                        <tr>
                            <td>@detalle.Inventario.Nombre_Producto</td>
                            <td>₡@(detalle.PrecioUnitario?.ToString("N2") ?? "0.00")</td>
                            <td>@detalle.Cantidad</td>
                            <td>₡@(detalle.Subtotal?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Totales -->
            <div class="row text-end mt-4">
                <div class="col-sm-12">
                    <p><strong>Subtotal:</strong> ₡@(Model.Subtotal?.ToString("N2") ?? "0.00")</p>
                    <p><strong>IVA (13%):</strong> ₡@(Model.IVA?.ToString("N2") ?? "0.00")</p>
                    <p><strong>Total (Bruto):</strong> ₡@(Model.Total?.ToString("N2") ?? "0.00")</p>

                    <!-- NUEVO: descuento acumulado y total neto -->
                    <p class="text-warning"><strong>Descuento acumulado:</strong> -₡@(((decimal)(ViewBag.DescuentoAcum ?? 0m)).ToString("N2"))</p>
                    <p class="text-success fw-bold"><strong>Total neto:</strong> ₡@(((decimal)(ViewBag.TotalNeto ?? 0m)).ToString("N2"))</p>
                </div>
            </div>

            <!-- Botones -->
            <div class="text-end mt-3">
                <a href="@Url.Action("AplicarPromocion", "Marketing", new { idVenta = Model.Id_Venta })"
                   class="btn ms-2" style="background-color: #A8E063; color: black; border-radius: 8px;">
                    <i class="fa fa-tags"></i> Aplicar Promoción
                </a>
                <a href="@Url.Action("Edit", new { id = Model.Id_Venta })"
                   class="btn ms-2" style="background-color: #A8E063; color: black; border-radius: 8px;">
                    <i class="fa fa-pen"></i> Editar
                </a>
                <a href="@Url.Action("Index")"
                   class="btn ms-2" style="background-color: #A8E063; color: black; border-radius: 8px;">
                    <i class="fa fa-arrow-left"></i> Volver
                </a>
            </div>


        </div>
    </div>
</div>
