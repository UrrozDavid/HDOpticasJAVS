@model HDOpticasJAVS.Models.PerfilClienteViewModel
@{
    ViewBag.Title = "Perfil del Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg text-white" style="background: linear-gradient(to right, #2193b0, #6dd5ed);">
        <div class="card-body text-center">
            <h2 class="mb-4">Bienvenido/a, @Model.NombreUsuario</h2>

            <div class="row justify-content-center">
                <div class="col-md-6">

                    <h4><i class="fa fa-calendar-alt"></i> Historial de Citas</h4>
                    <ul class="list-group mb-4">
                        @foreach (var cita in Model.HistorialCitas)
                        {
                            <li class="list-group-item bg-dark text-white border-secondary">
                                @cita.Fecha.ToString("dd/MM/yyyy") - @cita.Descripcion
                            </li>
                        }
                    </ul>

                    <h4><i class="fa fa-shopping-cart"></i> Historial de Compras</h4>
                    <ul class="list-group mb-4">
                        @foreach (var compra in Model.HistorialCompras)
                        {
                            <li class="list-group-item bg-dark text-white border-secondary">
                                <i class="fa fa-glasses"></i> @compra.Producto -
                                @compra.Monto.ToString("C0", new System.Globalization.CultureInfo("es-CR"))
                                - @compra.Fecha.ToString("dd/MM/yyyy")
                            </li>
                        }
                    </ul>

                    <h4><i class="fa fa-gift"></i> Historial de Promociones</h4>
                    <ul class="list-group mb-4">
                        @{

                            Html.RenderAction("HistorialPromociones", "Marketing", new { cedula = Model.CedulaCliente });
                        }
                    </ul>

                </div>
            </div>

            <div class="mt-4 text-light">
                <small>Última actualización: @Model.UltimaActualizacion.ToString("dd 'de' MMMM yyyy")</small>
            </div>
        </div>
    </div>
</div>
