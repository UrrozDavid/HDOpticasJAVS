@model HDOpticasJAVS.Models.ViewModels.HistorialClienteViewModel
@{
    ViewBag.Title = "Editar Historial Clínico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4 shadow-lg rounded-4 bg-dark text-white">
    <div class="card-header text-center rounded-top-4" style="background-color:#A8E063;">
        <h4 class="fw-bold mb-0 text-black">
            <i class="bi bi-journal-medical"></i> @ViewBag.Title
        </h4>
    </div>

    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@Html.Raw(TempData["ErrorMessage"])</div>
            </div>
        }

        @using (Html.BeginForm("EditarHistorial", "Clientes", FormMethod.Post, new { @class = "needs-validation" }))
        {
            @Html.AntiForgeryToken()

            @* Claves ocultas (para ubicar el registro exacto) *@
            @Html.HiddenFor(m => m.CedulaCliente)
            <input type="hidden" name="FechaRegistroIso" value="@Model.FechaRegistro?.ToString(" o")" />
            <input type="hidden" name="FechaRegistroTicks" value="@(Model.FechaRegistro?.Ticks)" />

            <div class="mb-3">
                <label class="form-label">Paciente</label>
                <input type="text" class="form-control" value="@(ViewBag.NombreCliente ?? "Cliente")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha del registro</label>
                <input type="text" class="form-control"
                       value="@(Model.FechaRegistro.HasValue ? Model.FechaRegistro.Value.ToString("dd/MM/yyyy HH:mm") : "")"
                       readonly />
                <small class="text-secondary">Esta fecha identifica el registro y no se puede modificar.</small>
            </div>

            <div class="mb-3">
                <label class="form-label" for="Antecedentes">Antecedentes</label>
                @Html.TextAreaFor(m => m.Antecedentes, 3, 60, new { @class = "form-control", placeholder = "Antecedentes...", id = "Antecedentes" })
                @Html.ValidationMessageFor(m => m.Antecedentes, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label" for="Diagnostico">Diagnóstico</label>
                @Html.TextAreaFor(m => m.Diagnostico, 3, 60, new { @class = "form-control", placeholder = "Diagnóstico...", id = "Diagnostico" })
                @Html.ValidationMessageFor(m => m.Diagnostico, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label" for="Tratamiento">Tratamiento</label>
                @Html.TextAreaFor(m => m.Tratamiento, 3, 60, new { @class = "form-control", placeholder = "Tratamiento...", id = "Tratamiento" })
                @Html.ValidationMessageFor(m => m.Tratamiento, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label" for="Observaciones">Observaciones</label>
                @Html.TextAreaFor(m => m.Observaciones, 3, 60, new { @class = "form-control", placeholder = "Observaciones...", id = "Observaciones" })
                @Html.ValidationMessageFor(m => m.Observaciones, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label" for="FechaProximoSeguimiento">Próximo seguimiento (opcional)</label>
                @Html.TextBoxFor(m => m.FechaProximoSeguimiento, "{0:yyyy-MM-dd}",
                                 new { @class = "form-control", type = "date", id = "FechaProximoSeguimiento" })
                <small class="text-secondary">Si lo indicas, se creará o actualizará la alerta de seguimiento.</small>
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="@Url.Action("Historial", "Clientes", new { cedula = Model.CedulaCliente })" class="btn btn-outline-light">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
                <button type="submit" class="btn fw-bold"
                        style="background-color:#A8E063; color:black; border-radius:8px;">
                    <i class="bi bi-save2 me-1"></i> Guardar Cambios
                </button>
            </div>
        }
    </div>
</div>
