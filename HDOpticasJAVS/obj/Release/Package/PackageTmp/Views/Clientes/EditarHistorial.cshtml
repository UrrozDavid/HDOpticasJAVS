@model HDOpticasJAVS.Models.ViewModels.HistorialClienteViewModel

@{
    ViewBag.Title = "Editar Historial Clínico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-verde {
        background-color: #A8E063;
        color: black !important;
        border: none;
    }

        .btn-verde:hover {
            background-color: #8DC44B;
            color: black !important;
        }

    .form-control-dark {
        background-color: #2c2c2c;
        color: white;
        border: 1px solid #555;
    }

        .form-control-dark::placeholder {
            color: #aaa;
        }
</style>

<div class="card mt-4 shadow-lg rounded-4 bg-dark text-white">
    <div class="card-header text-center rounded-top-4" style="background-color: #A8E063; color: black;">
        <h4 class="fw-bold mb-0">
            <i class="bi bi-pencil-square"></i> Editar Historial de @ViewBag.NombreCliente
        </h4>
    </div>

    <div class="card-body">
        @using (Html.BeginForm("EditarHistorial", "Clientes", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @* Claves ocultas: la fecha en ISO y en ticks para que el POST pueda reconstruirla *@
            @Html.HiddenFor(m => m.CedulaCliente)
            <input type="hidden" name="FechaRegistroIso" value="@(Model.FechaRegistro?.ToString("o"))" />
            <input type="hidden" name="FechaRegistroTicks" value="@(Model.FechaRegistro?.Ticks)" />

            <div class="mb-3">
                @Html.LabelFor(m => m.Antecedentes)
                @Html.TextAreaFor(m => m.Antecedentes, new { @class = "form-control form-control-dark", rows = 3 })
                @Html.ValidationMessageFor(m => m.Antecedentes, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Diagnostico)
                @Html.TextAreaFor(m => m.Diagnostico, new { @class = "form-control form-control-dark", rows = 3 })
                @Html.ValidationMessageFor(m => m.Diagnostico, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Tratamiento)
                @Html.TextAreaFor(m => m.Tratamiento, new { @class = "form-control form-control-dark", rows = 3 })
                @Html.ValidationMessageFor(m => m.Tratamiento, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Observaciones)
                @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control form-control-dark", rows = 3 })
                @Html.ValidationMessageFor(m => m.Observaciones, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.FechaProximoSeguimiento, "Fecha de Próximo Seguimiento (opcional)")
                @Html.TextBoxFor(m => m.FechaProximoSeguimiento, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-dark", type = "date" })
                @Html.ValidationMessageFor(m => m.FechaProximoSeguimiento, "", new { @class = "text-danger" })
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-verde">
                    <i class="bi bi-save2"></i> Guardar Cambios
                </button>
                <a href="@Url.Action("Historial", "Clientes", new { cedula = Model.CedulaCliente })" class="btn btn-verde ms-2">
                    <i class="bi bi-arrow-left-circle"></i> Cancelar
                </a>
            </div>
        }
    </div>
</div>
