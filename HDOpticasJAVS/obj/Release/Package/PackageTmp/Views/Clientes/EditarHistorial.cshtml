@model HDOpticasJAVS.Models.ViewModels.HistorialClienteViewModel

@{
    ViewBag.Title = "Editar Historial Clínico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4 shadow-lg rounded-4 bg-dark text-white">
    <div class="card-header bg-warning text-dark text-center rounded-top-4">
        <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Editar Historial de @ViewBag.NombreCliente</h4>
    </div>

    <div class="card-body">
        @using (Html.BeginForm("EditarHistorial", "Clientes", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.CedulaCliente)
            <input type="hidden" name="FechaRegistro" value="@Model.FechaRegistro?.ToString(" o")" />


            <div class="mb-3">
                @Html.LabelFor(m => m.Antecedentes)
                @Html.TextAreaFor(m => m.Antecedentes, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Antecedentes, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Diagnostico)
                @Html.TextAreaFor(m => m.Diagnostico, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Diagnostico, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Tratamiento)
                @Html.TextAreaFor(m => m.Tratamiento, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Tratamiento, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Observaciones)
                @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Observaciones, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.FechaProximoSeguimiento, "Fecha de Próximo Seguimiento (opcional)")
                @Html.TextBoxFor(m => m.FechaProximoSeguimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.FechaProximoSeguimiento, "", new { @class = "text-danger" })
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save2"></i> Guardar Cambios
                </button>
                <a href="@Url.Action("Historial", "Clientes", new { cedula = Model.CedulaCliente })" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left-circle"></i> Cancelar
                </a>
            </div>
        }
    </div>
</div>
