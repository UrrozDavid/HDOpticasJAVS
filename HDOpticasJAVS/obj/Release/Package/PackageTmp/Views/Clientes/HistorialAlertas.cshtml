@model List<HDOpticasJAVS.ViewModels.AlertaHistorialViewModel>
@{
    ViewBag.Title = "Historial de Alertas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-hover tbody tr:hover {
        background-color: #6c757d !important;
        color: #fff !important;
    }

    .bg-verde-personalizado {
        background-color: #A8E063 !important;
        color: #000 !important;
    }

    .btn-verde {
        background-color: #A8E063 !important;
        color: #000 !important;
        border: none;
    }

        .btn-verde:hover {
            background-color: #91cc56 !important;
            color: #000 !important;
        }
</style>

<div class="container mt-4">
    <div class="card shadow-lg rounded-4" style="background: #1e1e2f; color: #fff;">
        <div class="card-header text-center bg-verde-personalizado rounded-top-4">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-bell"></i> Historial de Alertas  @ViewBag.Cedula
            </h4>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i> No hay alertas enviadas registradas.
                </div>
            }
            else
            {
                <table class="table table-bordered table-hover mt-4">
                    <thead style="background-color: #333; color: white;">
                        <tr>
                            <th>Fecha de Alerta</th>
                            <th>Mensaje</th>
                            <th>Estado</th>
                            <th>Medio de Envío</th>
                        </tr>
                    </thead>
                    <tbody class="bg-dark text-white">
                        @foreach (var alerta in Model)
                        {
                            <tr>
                                <td>@(alerta.FechaAlerta.HasValue ? alerta.FechaAlerta.Value.ToString("yyyy-MM-dd HH:mm") : "Sin fecha")</td>
                                <td>@alerta.Mensaje</td>
                                <td>@(alerta.Enviada == true ? "Enviada" : "No enviada")</td>
                                <td>@alerta.MedioEnvio</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="text-center mt-4">
                <a href="@Url.Action("Index", "Clientes")" class="btn btn-verde rounded-3 px-4 py-2">
                    <i class="bi bi-arrow-left-circle"></i> Volver a Clientes
                </a>
            </div>
        </div>
    </div>
</div>
