@model HDOpticasJAVS.Models.ClienteViewModel
@{
    ViewBag.Title = "Registrar Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mt-4 shadow-lg rounded-4 bg-dark text-white">
    <div class="card-header bg-verde-personalizado text-center rounded-top-4" style="color: black;">
        <h4 class="fw-bold mb-0">Registro de Cliente</h4>
    </div>

    <div class="card-body">

        @* Mensaje de éxito *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>

            if (TempData["CedulaClienteRegistrado"] != null)
            {
                <div class="text-center mt-3">
                    <a href="@Url.Action("Detalles", "Clientes", new { id = TempData["CedulaClienteRegistrado"] })"
                       class="btn text-white" style="background-color: #A8E063;">
                        <i class="bi bi-person-lines-fill"></i> Ver cliente registrado
                    </a>
                </div>
            }
        }

        @* Mensaje de error general *@
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-start">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[""].Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <h5 class="text-white">Datos Personales</h5>

            <div class="form-group">
                @Html.LabelFor(m => m.Cedula)
                @Html.TextBoxFor(m => m.Cedula, new
                {
                    @class = "form-control " + (ViewData.ModelState["Cedula"]?.Errors.Any() == true ? "is-invalid" : "")
                })
                @Html.ValidationMessageFor(m => m.Cedula, null, new { @class = "invalid-feedback" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Nombre)
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Apellido1)
                @Html.TextBoxFor(m => m.Apellido1, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Apellido1, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Apellido2)
                @Html.TextBoxFor(m => m.Apellido2, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Apellido2, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Correo)
                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Fecha_Nacimiento)
                @Html.TextBoxFor(m => m.Fecha_Nacimiento, new { @class = "form-control", type = "date", id = "fechaNacimiento" })
                @Html.ValidationMessageFor(m => m.Fecha_Nacimiento, "", new { @class = "text-danger" })
            </div>

            <h5 class="text-white mt-4">Datos Clínicos</h5>

            <div class="form-group">
                @Html.LabelFor(m => m.Edad)
                @Html.TextBoxFor(m => m.Edad, new { @class = "form-control", type = "number", id = "edad", @readonly = "readonly" })
                @Html.ValidationMessageFor(m => m.Edad, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Genero)
                @Html.DropDownListFor(m => m.Genero, (SelectList)ViewBag.Generos, "-- Seleccione género --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Genero, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Numero_Telefono)
                @Html.TextBoxFor(m => m.Numero_Telefono, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Numero_Telefono, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Padecimiento)
                @Html.TextBoxFor(m => m.Padecimiento, new { @class = "form-control" })
            </div>

            <button type="submit" class="btn text-black mt-3" style="background-color: #A8E063;">
                <i class="bi bi-save"></i> Registrar Cliente
            </button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            $('#fechaNacimiento').on('change', function () {
                const fechaNacimiento = new Date($(this).val());
                const hoy = new Date();

                if (!isNaN(fechaNacimiento.getTime())) {
                    let edad = hoy.getFullYear() - fechaNacimiento.getFullYear();
                    const mes = hoy.getMonth() - fechaNacimiento.getMonth();

                    if (mes < 0 || (mes === 0 && hoy.getDate() < fechaNacimiento.getDate())) {
                        edad--;
                    }

                    if (edad >= 0 && edad <= 120) {
                        $('#edad').val(edad);
                    } else {
                        $('#edad').val('');
                    }
                } else {
                    $('#edad').val('');
                }
            });
        });
    </script>
}
