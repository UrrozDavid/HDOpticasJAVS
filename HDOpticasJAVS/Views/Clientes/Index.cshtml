@model List<HDOpticasJAVS.Cliente>
@{
    ViewBag.Title = "Clientes Registrados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 2800px; background: rgba(0, 0, 0, 0.85); color: #F1E0C6; border-radius: 15px;">
        <div class="card-header text-center" style="background-color: #1A73E8; color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <!-- Botones de acción arriba -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a href="@Url.Action("Crear", "Clientes")" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Registrar Nuevo Cliente
                </a>

                @if (Session["Rol"] != null && (int)Session["Rol"] == 1)
                {
                    <a href="@Url.Action("AccesosDenegados", "Clientes")" class="btn btn-outline-danger">
                        <i class="bi bi-shield-lock"></i> Ver Intentos No Autorizados
                    </a>
                }

                <form action="@Url.Action("EjecutarAlertas", "Clientes")" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-bell-fill"></i> Revisar y Enviar Alertas
                    </button>
                </form>

                <a href="@Url.Action("HistorialAlertas", "Clientes")" class="btn btn-outline-info">
                    <i class="bi bi-clock-history"></i> Historial de Alertas
                </a>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <table class="table table-dark table-hover table-bordered">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Apellido 1</th>
                            <th>Apellido 2</th>
                            <th>Fecha Nac.</th>
                            <th>Correo</th>
                            <th>Edad</th>
                            <th>Género</th>
                            <th>Padecimiento</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>@cliente.Cedula</td>
                                <td>@cliente.Nombre</td>
                                <td>@cliente.Apellido1</td>
                                <td>@cliente.Apellido2</td>
                                <td>@(cliente.Fecha_Nacimiento?.ToString("yyyy-MM-dd") ?? "N/D")</td>
                                <td>@cliente.Correo</td>
                                <td>@cliente.Edad</td>
                                <td>@cliente.Genero</td>
                                <td>@(string.IsNullOrEmpty(cliente.Padecimiento) ? "Ninguno" : cliente.Padecimiento)</td>
                                <td>@cliente.Numero_Telefono</td>
                                <td>
                                    @if (cliente.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap">
                                        <a href="@Url.Action("Detalles", "Clientes", new { cedula = cliente.Cedula })" class="btn btn-info btn-sm me-1 mb-1">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>

                                        @if (Session["Rol"] != null && (int)Session["Rol"] == 1)
                                        {
                                            <a href="@Url.Action("Editar", "Clientes", new { cedula = cliente.Cedula })" class="btn btn-warning btn-sm me-1 mb-1">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>
                                        }

                                        <a href="@Url.Action("Historial", "Clientes", new { cedula = cliente.Cedula })" class="btn btn-secondary btn-sm me-1 mb-1">
                                            🩺 Historial
                                        </a>

                                        @if (Session["Rol"] != null && ((int)Session["Rol"] == 1 || (int)Session["Rol"] == 2))
                                        {
                                            <a href="@Url.Action("RegistrarHistorial", "Clientes", new { cedula = cliente.Cedula })" class="btn btn-success btn-sm me-1 mb-1">
                                                <i class="bi bi-journal-plus"></i> Historial +
                                            </a>
                                        }

                                        @if (Session["Rol"] != null && (int)Session["Rol"] == 1)
                                        {
                                            <a href="@Url.Action("VerCambiosCliente", "Clientes", new { cedula = cliente.Cedula })" class="btn btn-outline-info btn-sm me-1 mb-1">
                                                <i class="bi bi-clock-history"></i> Ver Cambios
                                            </a>

                                            if (cliente.Activo)
                                            {
                                                <form action="@Url.Action("DesactivarCliente", "Clientes")" method="post" class="d-inline me-1 mb-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cedula" value="@cliente.Cedula" />
                                                    <button type="submit" class="btn btn-danger btn-sm"
                                                            onclick="return confirm('¿Está seguro que desea desactivar este cliente?');">
                                                        <i class="bi bi-person-x-fill"></i> Desactivar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form action="@Url.Action("ReactivarCliente", "Clientes")" method="post" class="d-inline me-1 mb-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cedula" value="@cliente.Cedula" />
                                                    <button type="submit" class="btn btn-success btn-sm"
                                                            onclick="return confirm('¿Desea reactivar este cliente?');">
                                                        <i class="bi bi-person-check-fill"></i> Reactivar
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    No hay clientes registrados aún.
                </div>
            }
        </div>
    </div>
</div>
