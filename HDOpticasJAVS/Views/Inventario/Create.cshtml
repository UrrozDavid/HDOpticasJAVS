@model HDOpticasJAVS.Models.ViewModels.Inventario

@{
    ViewBag.Title = "Crear Producto";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Nombre_Producto)
        @Html.EditorFor(m => m.Nombre_Producto, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.Nombre_Producto, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Codigo_Producto)
        @Html.EditorFor(m => m.Codigo_Producto, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.Codigo_Producto, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Stock)
        @Html.EditorFor(m => m.Stock, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
        @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Precio)
        @Html.EditorFor(m => m.Precio, new { htmlAttributes = new { @class = "form-control", step = "0.01", min = "0.01" } })
        @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Id_Proveedor)
        @Html.DropDownListFor(m => m.Id_Proveedor, (SelectList)ViewBag.Id_Proveedor, "Seleccione un proveedor", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Id_Proveedor, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Descripcion)
        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
        @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Estado)
        @Html.EditorFor(m => m.Estado, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.UsuarioCreador)
        @Html.EditorFor(m => m.UsuarioCreador, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.UsuarioCreador, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaCreacion)
        @Html.EditorFor(m => m.FechaCreacion, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
        @Html.ValidationMessageFor(m => m.FechaCreacion, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.UsuarioModificador)
        @Html.EditorFor(m => m.UsuarioModificador, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.UsuarioModificador, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaModificacion)
        @Html.EditorFor(m => m.FechaModificacion, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
        @Html.ValidationMessageFor(m => m.FechaModificacion, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Crear Producto</button>
}

<div class="mt-3">
    <a href="@Url.Action("Index")" class="btn btn-secondary">Volver a la lista</a>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}