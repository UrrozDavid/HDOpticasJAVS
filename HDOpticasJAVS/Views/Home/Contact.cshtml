@{
    ViewBag.Title = "Contacto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: white; 
    }

    .recuadro-oscuro {
        background-color: rgba(0, 0, 0, 0.85);
        padding: 30px;
        border-radius: 15px;
        color: #F1E0C6;
        max-width: 900px;
        margin: 30px auto;
        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.4);
    }

        .recuadro-oscuro h1,
        .recuadro-oscuro h2 {
            color: #A8E063;
            font-family: 'Poppins', sans-serif;
            font-weight: bold;
        }

        .recuadro-oscuro p, a {
            font-size: 1.2rem;
            color: #F1E0C6;
            font-family: 'Nunito', sans-serif;
        }

    .icono-verde {
        color: #A8E063;
        font-size: 1.3rem;
        margin-right: 8px;
    }

    .linea-verde {
        border: none;
        height: 4px;
        background-color: #A8E063;
        width: 80%;
        margin: 50px auto;
        border-radius: 5px;
    }
</style>

<div class="recuadro-oscuro text-center animate__animated animate__fadeInDown">
    <h1>Contáctanos</h1>
    <p>Estamos aquí para ayudarte con cualquier consulta o información que necesites.</p>
</div>

<hr class="linea-verde" />


<div class="recuadro-oscuro text-center animate__animated animate__fadeInUp">
    <h2>Información de Contacto</h2>
    <p><i class="fas fa-envelope icono-verde"></i>Correo: <a href="mailto:hdopticascr@gmail.com">hdopticascr@gmail.com</a></p>
    <p><i class="fas fa-phone icono-verde"></i>Tel: <a href="tel:+50622214315">+506 2221-4315</a></p>
</div>


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
