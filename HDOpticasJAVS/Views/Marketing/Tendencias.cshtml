@model List<HDOpticasJAVS.ViewModels.CampaniaTendenciaViewModel>
@using Newtonsoft.Json
@{
    ViewBag.Title = "Análisis de Tendencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-verde {
        background-color: #A8E063;
        color: black !important;
        border: none;
        font-weight: bold;
    }

        .btn-verde:hover {
            background-color: #8DC44B;
            color: black !important;
        }

    .chart-container {
        background-color: #212529;
        border-radius: 10px;
        padding: 20px;
        margin-top: 30px;
        height: 400px;
    }

    canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .acciones-finales {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 16px;
    }
</style>

<div class="card mt-4 shadow-lg border-0">
    <!-- Header -->
    <div class="card-header text-center" style="background-color:#A8E063; color:black;">
        <h2 class="fw-bold m-0" style="font-family:'Poppins',sans-serif; color:#000;">📊 Análisis de Tendencias</h2>
    </div>

    <div class="card-body bg-dark text-white">
        <!-- Filtros -->
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label for="desde" class="form-label">Desde:</label>
                <input type="date" name="desde" id="desde" class="form-control bg-dark text-white border-light" />
            </div>
            <div class="col-auto">
                <label for="hasta" class="form-label">Hasta:</label>
                <input type="date" name="hasta" id="hasta" class="form-control bg-dark text-white border-light" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-verde">Filtrar</button>
            </div>
        </form>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-warning">@ViewBag.Mensaje</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-striped mt-3 align-middle">
                    <thead style="background-color:#2b2b2b;">
                        <tr>
                            <th>Campaña</th>
                            <th>Enviados</th>
                            <th>Abiertos</th>
                            <th>Clicks</th>
                            <th>% Apertura</th>
                            <th>% Click</th>
                            <th>Desde</th>
                            <th>Hasta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var rowClass = item.MetricaInvalida ? "table-danger" : "";
                            <tr class="@rowClass">
                                <td>@item.NombreCampania</td>
                                <td>@item.TotalEnviados</td>
                                <td>@item.TotalAbiertos</td>
                                <td>@item.TotalClicks</td>
                                <td>@item.PorcentajeApertura.ToString("F2")%</td>
                                <td>@item.PorcentajeClick.ToString("F2")%</td>
                                <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                                <td>@(item.FechaFin.HasValue ? item.FechaFin.Value.ToString("yyyy-MM-dd") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* if sin @ porque seguimos dentro del bloque else *@
            if (Model.Any(m => m.MetricaInvalida))
            {
                <div class="alert alert-danger mt-3">
                    ⚠️ Se detectaron métricas inconsistentes en una o más campañas. Verifique los datos o regenere el reporte.
                </div>
            }

            <!-- Acciones finales -->
            <div class="acciones-finales">
                <a href="@Url.Action("Historial", "Marketing")" class="btn btn-verde">
                    ⬅️ Volver al Historial
                </a>

                <div class="d-flex flex-wrap gap-2">
                    <form method="post" action="@Url.Action("ExportarTendencias", "Marketing")" class="d-inline">
                        <input type="hidden" name="desde" value="@Request["desde"]" />
                        <input type="hidden" name="hasta" value="@Request["hasta"]" />
                        <button type="submit" class="btn btn-verde">📊 Exportar a Excel</button>
                    </form>

                    <button class="btn btn-verde" onclick="descargarImagen()">📸 Descargar Gráficos como PNG</button>
                    <button class="btn btn-verde" onclick="descargarPDF()">📄 Exportar Gráficos a PDF</button>
                </div>
            </div>

            <div class="chart-container">
                <h4 style="color:#A8E063;">📈 Gráfico de Aperturas y Clics por Campaña</h4>
                <canvas id="graficoAperturasClicks"></canvas>
            </div>

            <div class="chart-container">
                <h4 style="color:#A8E063;">📉 Evolución por Fecha (Inicio de Campaña)</h4>
                <canvas id="graficoLineaFechas"></canvas>
            </div>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
    const nombres = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.NombreCampania)));
    const abiertos = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.TotalAbiertos)));
    const clicks   = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.TotalClicks)));
    const fechas   = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.FechaInicio.ToString("yyyy-MM-dd"))));

    const bgPlugin = {
      id: 'canvas_bg',
      beforeDraw: (chart, args, opts) => {
        if (!opts || !opts.color) return;
        const { ctx, width, height } = chart;
        ctx.save();
        ctx.globalCompositeOperation = 'destination-over';
        ctx.fillStyle = opts.color;
        ctx.fillRect(0, 0, width, height);
        ctx.restore();
      }
    };
    Chart.register(bgPlugin);

    const baseOptions = {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: {
          ticks: {
            color: '#fff',
            autoSkip: true,
            maxRotation: 35,
            minRotation: 20,
            font: { size: 11 }
          },
          grid: { color: '#444' }
        },
        y: {
          beginAtZero: true,
          ticks: { color: '#fff', font: { size: 11 } },
          grid: { color: '#444' }
        }
      },
      plugins: {
        legend: { position: 'bottom', labels: { color: '#fff', font: { size: 12 } } },
        tooltip: { backgroundColor: '#343a40', titleColor: '#fff', bodyColor: '#fff' },
        title: { display: true, color: '#fff', font: { size: 16, weight: 'bold' }, text: '' },
        canvas_bg: { color: 'rgba(0,0,0,0)' }
      },
      elements: {
        line: { borderWidth: 3 },
        point: { radius: 3, hitRadius: 6 }
      }
    };

    const barCtx = document.getElementById('graficoAperturasClicks').getContext('2d');
    const barOptions = JSON.parse(JSON.stringify(baseOptions));
    barOptions.plugins.title.text = 'Aperturas y clics por campaña';
    barOptions.datasets = { bar: { categoryPercentage: 0.6, barPercentage: 0.9 } };
    barOptions.scales.x.ticks.callback = function (value, index) {
      return index % 2 === 0 ? this.getLabelForValue(value) : '';
    };

    const chartBar = new Chart(barCtx, {
      type: 'bar',
      data: {
        labels: nombres,
        datasets: [
          { label: 'Abiertos', data: abiertos, backgroundColor: 'rgba(54,162,235,0.85)' },
          { label: 'Clics', data: clicks, backgroundColor: 'rgba(255,206,86,0.85)' }
        ]
      },
      options: barOptions
    });

    const lineCtx = document.getElementById('graficoLineaFechas').getContext('2d');
    const lineOptions = JSON.parse(JSON.stringify(baseOptions));
    lineOptions.plugins.title.text = 'Evolución por fecha (inicio de campaña)';
    lineOptions.elements.line.borderWidth = 4;
    lineOptions.elements.point.radius = 5;

    const chartLine = new Chart(lineCtx, {
      type: 'line',
      data: {
        labels: fechas,
        datasets: [
          { label: 'Abiertos', data: abiertos, borderColor: 'rgba(54,162,235,1)', fill: false, tension: 0.2 },
          { label: 'Clics', data: clicks, borderColor: 'rgba(255,206,86,1)', fill: false, tension: 0.2 }
        ]
      },
      options: lineOptions
    });

    function toPrintTheme(chart) {
      const o = chart.options;
      o.scales.x.ticks.color = '#000';
      o.scales.x.ticks.font = { size: 16, weight: '600' };
      o.scales.y.ticks.color = '#000';
      o.scales.y.ticks.font = { size: 16, weight: '600' };
      o.plugins.legend.labels.color = '#000';
      o.plugins.legend.labels.font = { size: 16, weight: '600' };
      o.plugins.title.color = '#000';
      o.plugins.title.font = { size: 20, weight: 'bold' };
      o.plugins.canvas_bg = { color: '#fff' };
      chart.update('none');
    }

    function toScreenTheme(chart) {
      const o = chart.options;
      o.scales.x.ticks.color = '#fff';
      o.scales.x.ticks.font = { size: 11 };
      o.scales.y.ticks.color = '#fff';
      o.scales.y.ticks.font = { size: 11 };
      o.plugins.legend.labels.color = '#fff';
      o.plugins.legend.labels.font = { size: 12 };
      o.plugins.title.color = '#fff';
      o.plugins.title.font = { size: 16, weight: 'bold' };
      o.plugins.canvas_bg = { color: 'rgba(0,0,0,0)' };
      chart.update('none');
    }

    function snapshotBase64(chart, w = 3200, h = 2000) {
      const cw = chart.width, ch = chart.height;
      chart.resize(w, h);
      toPrintTheme(chart);
      const b64 = chart.toBase64Image();
      toScreenTheme(chart);
      chart.resize(cw, ch);
      return b64;
    }

    function descargarImagen() {
      const save = (b64, name) => { const a = document.createElement('a'); a.href = b64; a.download = name; a.click(); };
      save(snapshotBase64(chartBar), 'grafico_aperturas_clicks.png');
      save(snapshotBase64(chartLine), 'grafico_evolucion_fechas.png');
    }

    function descargarPDF() {
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF('l', 'mm', 'a4');
      const img1 = snapshotBase64(chartBar);
      pdf.addImage(img1, 'PNG', 10, 15, 270, 170);
      pdf.addPage();
      const img2 = snapshotBase64(chartLine);
      pdf.addImage(img2, 'PNG', 10, 15, 270, 170);
      pdf.save('TendenciasMarketing.pdf');
    }
    </script>
}

