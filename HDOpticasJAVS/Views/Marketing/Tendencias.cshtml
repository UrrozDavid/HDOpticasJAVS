@model List<HDOpticasJAVS.ViewModels.CampaniaTendenciaViewModel>
@using Newtonsoft.Json
@{
    ViewBag.Title = "Análisis de Tendencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .chart-container {
        background-color: #212529;
        border-radius: 10px;
        padding: 20px;
        margin-top: 30px;
        height: 400px;
    }

    canvas {
        width: 100% !important;
        height: 100% !important;
    }
</style>


<h2 class="text-primary">📊 Análisis de Tendencias</h2>

<form method="get" class="form-inline mb-3">
    <label for="desde">Desde:</label>
    <input type="date" name="desde" class="form-control mx-2" />
    <label for="hasta">Hasta:</label>
    <input type="date" name="hasta" class="form-control mx-2" />
    <button type="submit" class="btn btn-primary">Filtrar</button>
</form>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning">@ViewBag.Mensaje</div>
}
else
{
    <table class="table table-dark table-striped mt-3">
        <thead>
            <tr>
                <th>Campaña</th>
                <th>Enviados</th>
                <th>Abiertos</th>
                <th>Clicks</th>
                <th>% Apertura</th>
                <th>% Click</th>
                <th>Desde</th>
                <th>Hasta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var rowClass = item.MetricaInvalida ? "table-danger" : "";
                <tr class="@rowClass">
                    <td>@item.NombreCampania</td>
                    <td>@item.TotalEnviados</td>
                    <td>@item.TotalAbiertos</td>
                    <td>@item.TotalClicks</td>
                    <td>@item.PorcentajeApertura.ToString("F2")%</td>
                    <td>@item.PorcentajeClick.ToString("F2")%</td>
                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                    <td> @(item.FechaFin.HasValue ? item.FechaFin.Value.ToString("yyyy-MM-dd") : "—")</td>
                </tr>
            }
        </tbody>
    </table>

    if (Model.Any(m => m.MetricaInvalida))
    {
        <div class="alert alert-danger mt-3">
            ⚠️ Se detectaron métricas inconsistentes en una o más campañas. Verifique los datos o regenere el reporte.
        </div>
    }

    <form method="post" action="@Url.Action("ExportarTendencias", "Marketing")">
        <input type="hidden" name="desde" value="@Request["desde"]" />
        <input type="hidden" name="hasta" value="@Request["hasta"]" />
        <button type="submit" class="btn btn-success mt-3">Exportar a Excel</button>
    </form>

    <div class="mt-3">
        <button class="btn btn-info" onclick="descargarImagen()">📸 Descargar Gráficos como PNG</button>
        <button class="btn btn-secondary" onclick="descargarPDF()">📄 Exportar Gráficos a PDF</button>
    </div>

    <div class="chart-container">
        <h4 class="text-info">📈 Gráfico de Aperturas y Clics por Campaña</h4>
        <canvas id="graficoAperturasClicks"></canvas>
    </div>

    <div class="chart-container">
        <h4 class="text-info">📉 Evolución por Fecha (Inicio de Campaña)</h4>
        <canvas id="graficoLineaFechas"></canvas>
    </div>

}

@if (Model != null && Model.Any())
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        const nombres = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.NombreCampania)));
        const abiertos = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.TotalAbiertos)));
        const clicks = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.TotalClicks)));
        const fechas = @Html.Raw(JsonConvert.SerializeObject(Model.Select(m => m.FechaInicio.ToString("yyyy-MM-dd"))));

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    ticks: { color: '#ffffff' },
                    grid: { color: '#444' }
                },
                y: {
                    beginAtZero: true,
                    ticks: { color: '#ffffff' },
                    grid: { color: '#444' }
                }
            },
            plugins: {
                legend: {
                    labels: { color: '#ffffff' }
                },
                tooltip: {
                    backgroundColor: '#343a40',
                    titleColor: '#ffffff',
                    bodyColor: '#ffffff'
                }
            }
        };

        const ctxBar = document.getElementById('graficoAperturasClicks').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: nombres,
                datasets: [
                    {
                        label: 'Abiertos',
                        data: abiertos,
                        backgroundColor: 'rgba(54, 162, 235, 0.7)'
                    },
                    {
                        label: 'Clicks',
                        data: clicks,
                        backgroundColor: 'rgba(255, 206, 86, 0.7)'
                    }
                ]
            },
            options: chartOptions
        });

        const ctxLine = document.getElementById('graficoLineaFechas').getContext('2d');
        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: fechas,
                datasets: [
                    {
                        label: 'Abiertos',
                        data: abiertos,
                        borderColor: 'rgba(54, 162, 235, 1)',
                        fill: false,
                        tension: 0.1
                    },
                    {
                        label: 'Clicks',
                        data: clicks,
                        borderColor: 'rgba(255, 206, 86, 1)',
                        fill: false,
                        tension: 0.1
                    }
                ]
            },
            options: chartOptions
        });

        function descargarImagen() {
            html2canvas(document.getElementById('graficoAperturasClicks')).then(function (canvas1) {
                var link1 = document.createElement('a');
                link1.download = 'grafico_aperturas_clicks.png';
                link1.href = canvas1.toDataURL();
                link1.click();
            });

            html2canvas(document.getElementById('graficoLineaFechas')).then(function (canvas2) {
                var link2 = document.createElement('a');
                link2.download = 'grafico_linea_fechas.png';
                link2.href = canvas2.toDataURL();
                link2.click();
            });
        }

        async function descargarPDF() {
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');

            const canvas1 = await html2canvas(document.getElementById('graficoAperturasClicks'));
            const img1 = canvas1.toDataURL('image/png');
            pdf.text('📈 Aperturas y Clics por Campaña', 10, 10);
            pdf.addImage(img1, 'PNG', 10, 15, 190, 80);

            const canvas2 = await html2canvas(document.getElementById('graficoLineaFechas'));
            const img2 = canvas2.toDataURL('image/png');
            pdf.addPage();
            pdf.text('📉 Evolución por Fecha', 10, 10);
            pdf.addImage(img2, 'PNG', 10, 15, 190, 80);

            pdf.save('TendenciasMarketing.pdf');
        }
    </script>
}
