@{
    ViewBag.Title = "Detalles de la Campaña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card-dark {
        background-color: #1f1f1f;
        color: #F1E0C6;
    }

    .header-verde {
        background-color: #A8E063;
        color: #000;
    }

    .btn-verde {
        background-color: #A8E063;
        border-color: #A8E063;
        color: #000;
        font-weight: 600;
    }

        .btn-verde:hover {
            background-color: #8DC44B;
            border-color: #8DC44B;
            color: #000;
        }

    .mensaje-campania {
        background-color: #2c2c2c;
        color: #fff;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 1rem;
    }
</style>

<div class="card mt-4 shadow-lg rounded-4 card-dark">
    <div class="card-header text-center rounded-top-4 header-verde">
        <h4 class="fw-bold mb-0">Detalles de la Campaña</h4>
    </div>

    <div class="card-body rounded-bottom-4">
        <div class="mb-3">
            <strong>Título:</strong>
            <p>@ViewBag.Titulo</p>
        </div>

        <div class="mb-3">
            <strong>Segmento:</strong>
            <p>@ViewBag.Segmento</p>
        </div>

        <div class="mb-3">
            <strong>Fecha de Envío:</strong>
            <p>@ViewBag.FechaEnvio</p>
        </div>

        <div class="mb-3">
            <strong>Mensaje:</strong>
            <div class="mensaje-campania">
                @Html.Raw(ViewBag.Mensaje)
            </div>
        </div>

        <a href="@Url.Action("Historial", "Marketing")" class="btn btn-verde mt-3">
            Volver al Historial
        </a>
    </div>
</div>
