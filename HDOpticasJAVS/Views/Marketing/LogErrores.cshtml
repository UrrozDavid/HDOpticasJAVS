@model List<HDOpticasJAVS.LogSistema>

@{
    ViewBag.Title = "Registro de Errores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 1100px; background: rgba(0, 0, 0, 0.85); color: #F1E0C6; border-radius: 15px;">
        <!-- Título -->
        <div class="card-header text-center" style="background-color: #A8E063; color: black; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">🧾 Registro de Errores del Sistema</h2>
        </div>

        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            @if (!Model.Any())
            {
                <div class="alert alert-success text-center fw-semibold">
                    ✅ No hay errores recientes registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-bordered align-middle">
                        <thead class="table-light text-dark" style="font-family: Raleway;">
                            <tr class="text-center">
                                <th>Fecha</th>
                                <th>Módulo</th>
                                <th>Mensaje</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@log.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@log.Modulo</td>
                                    <td>@log.Mensaje</td>
                                    <td>@log.Usuario</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Botón de volver -->
            <div class="text-end mt-4">
                <a href="@Url.Action("Historial", "Marketing")" class="btn" style="background-color:#A8E063; color:black; font-weight:bold; border-radius:8px;">
                    ⬅️ Volver al Historial
                </a>
            </div>
        </div>
    </div>
</div>
