@model HDOpticasJAVS.Models.ViewModels.ReglasRecurrenciaViewModel

@{
    ViewBag.Title = "Configuración de Clientes Recurrentes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg p-4" style="max-width: 600px; width: 100%; background-color: #1f1f1f; color: #F1E0C6; border-radius: 15px;">

        <!-- Encabezado -->
        <div class="card-header text-center" style="background-color: #A8E063; color: black; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h3 class="fw-bold" style="font-family: 'Poppins', sans-serif;">🎯 Reglas para Clientes Recurrentes</h3>
        </div>

        <div class="card-body">
            <!-- Mensajes de éxito o error -->
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show text-center" role="alert" style="background-color: #A8E063; color: black; font-weight: bold;">
                    ✅ @TempData["Exito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
                    ❌ @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @using (Html.BeginForm("GuardarConfiguracionRecurrencia", "Marketing", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group mb-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.UmbralCompras)</label>
                    @Html.TextBoxFor(m => m.UmbralCompras, new { @class = "form-control", type = "number", min = "1" })
                    @Html.ValidationMessageFor(m => m.UmbralCompras, null, new { @class = "text-danger" })
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success fw-bold" style="color: black;">
                        💾 Guardar Configuración
                    </button>
                    <a href="@Url.Action("Index", "Marketing")" class="btn btn-success fw-bold ms-2" style="color: black;">
                        ↩ Volver
                    </a>
                </div>
            }
        </div>
    </div>
</div>
