@model HDOpticasJAVS.Models.ViewModels.CampaniaReporteViewModel

<div class="container mt-4 d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 1100px; background: rgba(0, 0, 0, 0.85); color: #F1E0C6; border-radius: 15px;">
        <!-- Encabezado -->
        <div class="card-header text-center" style="background-color: #A8E063; color: black; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">📊 @Model.Nombre_Campania</h2>
        </div>

        <!-- Cuerpo -->
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            <p class="mb-4">@Model.Descripcion</p>

            <div class="row text-center">
                <!-- Destinatarios -->
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow" style="background-color:#2C2C2C; border-radius:12px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold" style="color:#A8E063;">Destinatarios</h5>
                            <p class="card-text display-4 fw-bold">@Model.TotalDestinatarios</p>
                        </div>
                    </div>
                </div>

                <!-- Correos abiertos -->
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow" style="background-color:#1A73E8; border-radius:12px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-white">Correos Abiertos</h5>
                            <p class="card-text display-4 fw-bold">@Model.TotalAbiertos</p>
                            <small class="text-light fw-semibold">@Model.PorcentajeApertura % de apertura</small>
                        </div>
                    </div>
                </div>

                <!-- Promociones aplicadas -->
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow" style="background-color:#A8E063; color:black; border-radius:12px;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Promociones Aplicadas</h5>
                            <p class="card-text display-4 fw-bold">@Model.TotalClicks</p>
                            <small class="fw-semibold">@Model.PorcentajeClicks % de conversión</small>

                            <div class="mt-4">
                                <a href="@Url.Action("ExportarExcel", "Marketing", new { id = Model.Id_Campania })"
                                   class="btn btn-success btn-sm fw-bold">
                                    📄 Exportar a Excel
                                </a>
                                <a href="@Url.Action("ExportarPdf", "Marketing", new { id = Model.Id_Campania })"
                                   class="btn btn-danger btn-sm fw-bold ms-2">
                                    📝 Exportar a PDF
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
