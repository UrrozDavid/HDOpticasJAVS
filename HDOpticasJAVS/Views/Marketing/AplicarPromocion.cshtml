@{
    ViewBag.Title = "Aplicar Promoción";

    // Valores seguros (si vienen nulos)
    decimal sub = Convert.ToDecimal(ViewBag.Subtotal ?? 0m);
    decimal iva = Convert.ToDecimal(ViewBag.IVA ?? 0m);
    decimal desc = Convert.ToDecimal(ViewBag.DescAcum ?? 0m);
    decimal brut = Convert.ToDecimal(ViewBag.TotalBruto ?? 0m);
    decimal neto = Convert.ToDecimal(ViewBag.TotalNeto ?? (brut - desc));
}

<style>
    .pv-card {
        background: #1f1f1f;
        color: #fff;
        border-radius: 15px;
    }

    .pv-header {
        background: #A8E063;
        color: #000;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .pv-pill {
        background: #A8E063;
        color: #000;
        border-radius: 12px;
    }

    .pv-pill-dark {
        background: #2f8f57;
        color: #000;
        border-radius: 12px;
    }

    .pv-label-sm {
        font-size: .85rem;
        opacity: .9;
    }

    .pv-value {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
    }

    .pv-btn-green {
        background: #A8E063;
        color: #000;
        border-radius: 8px;
        font-weight: 600;
    }

        .pv-btn-green:hover {
            filter: brightness(.95);
            color: #000;
        }

    .pv-form .form-label {
        color: #dcdcdc;
    }
</style>

<div class="card shadow-lg pv-card p-0">
    <div class="card-header pv-header">
        <h4 class="fw-bold m-0" style="font-family:'Poppins',sans-serif;">
            Aplicar Promoción a la venta #@ViewBag.IdVenta
        </h4>
    </div>

    <div class="card-body pv-form" style="font-family:'Roboto',sans-serif;">

        <!-- Métricas -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="pv-pill p-3">
                    <div class="pv-label-sm">Subtotal</div>
                    <p class="pv-value">₡@sub.ToString("N2")</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="pv-pill p-3">
                    <div class="pv-label-sm">IVA</div>
                    <p class="pv-value">₡@iva.ToString("N2")</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="pv-pill p-3">
                    <div class="pv-label-sm">Descuento acumulado</div>
                    <p class="pv-value">-₡@desc.ToString("N2")</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="pv-pill-dark p-3">
                    <div class="pv-label-sm">Total neto</div>
                    <p class="pv-value">₡@neto.ToString("N2")</p>
                </div>
            </div>
        </div>

        <!-- Mensajes -->
        @if (TempData["Error"] != null)
        {<div class="alert alert-danger">@TempData["Error"]</div>}
        @if (TempData["Mensaje"] != null)
        {<div class="alert alert-success">@TempData["Mensaje"]</div>}

        <!-- Formulario -->
        @using (Html.BeginForm("AplicarPromocion", "Marketing", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="idVenta" value="@ViewBag.IdVenta" />

            <div class="mb-3">
                <label class="form-label">Campaña</label>
                @Html.DropDownList(
                    "idCampania",
                    (SelectList)ViewBag.Campanias,
                    "-- Seleccione --",
                    new { @class = "form-select" })
            </div>

            <div class="mb-3">
                <label class="form-label">Monto descuento</label>
                <input type="number" step="0.01" min="0.01" name="montoDescuento" class="form-control" required />
            </div>

            <div class="mb-4">
                <label class="form-label">Código promo (opcional)</label>
                <input type="text" name="codigoPromo" class="form-control" />
            </div>

            <div class="d-flex">
                <button type="submit" class="btn pv-btn-green">
                    <i class="fa fa-check"></i> Aplicar
                </button>
                <a href="@Url.Action("Index","PuntoVenta")" class="btn pv-btn-green">
                    <i class="fa fa-arrow-left"></i> Volver
                </a>
            </div>
        }
    </div>
</div>
