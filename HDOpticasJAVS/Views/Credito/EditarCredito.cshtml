@model HDOpticasJAVS.NotaCredito

@{
    ViewBag.Title = "Editar Crédito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg w-100" style="max-width: 800px; border-radius: 15px;">

        <div class="card-header text-center bg-primary text-white" style="border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body bg-dark text-light" style="border-bottom-left-radius: 15px; border-bottom-right-radius: 15px; font-family: 'Roboto', sans-serif;">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id_NotaCredito)

                <div class="form-group mb-3">
                    <label class="fw-bold">Monto Otorgado</label>
                    <input type="text" class="form-control" value="@Model.MontoOtorgado.ToString("C")" readonly />
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Saldo Pendiente</label>
                    @Html.TextBoxFor(m => m.SaldoPendiente, new { @class = "form-control" })
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Estado</label>
                    @Html.DropDownListFor(m => m.Estado,
                        new SelectList(new[] {
                            new { Value = "A", Text = "Activo" },
                            new { Value = "C", Text = "Cancelado" }
                        }, "Value", "Text", Model.Estado),
                        new { @class = "form-select" })
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success fw-bold px-4">Guardar Cambios</button>
                    <a href="@Url.Action("AdminCreditos")" class="btn btn-secondary fw-bold px-4">Volver</a>
                </div>
            }
        </div>
    </div>
</div>