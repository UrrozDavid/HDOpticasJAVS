@model HDOpticasJAVS.NotaCredito

@{
    ViewBag.Title = "Pagar Crédito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Header verde centrado con título negro en negrita */
    .container-fluid.p-4 > .card > .card-header {
        background: #A8E063 !important;
        color: #000 !important;
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
        text-align: center;
    }

        .container-fluid.p-4 > .card > .card-header h2 {
            margin: 0;
            font-weight: 800 !important;
        }

    /* Card oscuro, centrado y pegado al header */
    .container-fluid.p-4 > .card {
        max-width: 1100px;
        margin: 20px auto;
        background: #1f1f1f !important;
        color: #F1E0C6 !important;
        border: 1px solid #2c2c2c;
        border-top: 0;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 12px 24px rgba(0,0,0,.25);
    }

    /* Labels y campos en modo oscuro */
    .container-fluid.p-4 .card-body label {
        color: #cfcfcf !important;
        font-weight: 700;
    }

    .container-fluid.p-4 .form-control,
    .container-fluid.p-4 .form-select {
        background: #2a2a2a !important;
        color: #fff !important;
        border: 1px solid #3b3b3b !important;
    }

        .container-fluid.p-4 .form-control:focus,
        .container-fluid.p-4 .form-select:focus {
            background: #2f2f2f !important;
            color: #fff !important;
            border-color: #5b5b5b !important;
            box-shadow: none !important;
        }

    /* Panel de datos de tarjeta */
    #tarjeta-info {
        background: rgba(255,255,255,.03) !important;
        border: 1px solid rgba(255,255,255,.12) !important;
    }

    /* Botones: todos verdes con letras negras */
    .container-fluid.p-4 .btn-success,
    .container-fluid.p-4 .btn-secondary {
        background: #A8E063 !important;
        color: #000 !important;
        border: none !important;
        border-radius: 8px;
        font-weight: 700;
    }

        .container-fluid.p-4 .btn-success:hover,
        .container-fluid.p-4 .btn-secondary:hover {
            filter: brightness(.95);
            color: #000 !important;
        }
</style>


<div class="container-fluid p-4" style="min-height: 100vh; background: rgba(0, 0, 0, 0.85); color: #F1E0C6;">
    <div class="card shadow-lg mb-4" style="background: rgba(0,0,0,0.75); border-radius: 15px;">

        <!-- Encabezado -->
        <div class="card-header text-center" style="background-color: #1A73E8; color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <!-- Cuerpo -->
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            <div class="mb-4">
                <h5 class="fw-bold">📑 Detalle del Crédito</h5>
                <p><strong>Monto original:</strong> @Model.MontoOtorgado.ToString("C")</p>
                <p><strong>Saldo pendiente:</strong> @Model.SaldoPendiente.ToString("C")</p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label for="monto" class="fw-bold">Monto a pagar</label>
                    <input type="number" step="0.01" class="form-control" name="monto" required />
                </div>

                <div class="form-group mb-3">
                    <label for="metodo" class="fw-bold">Método de pago</label>
                    <select name="metodo" class="form-select" id="metodo" required>
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta</option>
                    </select>
                </div>

                <!-- Info Tarjeta -->
                <div id="tarjeta-info" class="p-3 rounded" style="display:none; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <h6 class="fw-bold mb-3">💳 Datos de la Tarjeta</h6>
                    <div class="form-group mb-2">
                        <label>Número de tarjeta</label>
                        <input type="text" class="form-control" name="numeroTarjeta" maxlength="16" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Nombre del titular</label>
                        <input type="text" class="form-control" name="nombreTitular" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Fecha vencimiento</label>
                        <input type="text" class="form-control" name="fechaVencimiento" placeholder="MM/YY" maxlength="5" />
                    </div>
                    <div class="form-group mb-2">
                        <label>CVV</label>
                        <input type="text" class="form-control" name="cvv" maxlength="3" />
                    </div>
                </div>

                <!-- Botones -->
                <div class="mt-4 text-center">
                    <button type="submit" class="btn btn-success fw-bold px-4 me-2">💸 Pagar</button>
                    <a href="@Url.Action("MisCreditos")" class="btn btn-secondary fw-bold px-4">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.getElementById("metodo").addEventListener("change", function () {
            var tarjetaInfo = document.getElementById("tarjeta-info");
            tarjetaInfo.style.display = (this.value === "Tarjeta") ? "block" : "none";
        });
    </script>
}