@model IEnumerable<HDOpticasJAVS.NotaCredito>

@{
    ViewBag.Title = "Mis Créditos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Header verde, centrado y en negrita */
    .container-fluid.p-4 > .card > .card-header {
        background: #A8E063 !important;
        color: #000 !important;
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
        text-align: center;
    }

        .container-fluid.p-4 > .card > .card-header h2 {
            margin: 0;
            font-weight: 800;
        }

    /* Card oscuro, centrado y pegado al header */
    .container-fluid.p-4 > .card {
        max-width: 1100px;
        margin: 20px auto;
        background: #1f1f1f !important;
        color: #F1E0C6 !important;
        border: 1px solid #2c2c2c;
        border-top: 0;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 12px 24px rgba(0,0,0,.25);
    }

    /* Tabla: encabezado claro, filas hover sutil */
    .container-fluid.p-4 .table thead {
        background: #f8f9fa;
        color: #111;
    }

    .container-fluid.p-4 .table tbody tr:hover {
        background: rgba(255,255,255,.03);
    }

    /* Botón "Pagar" (btn-primary) → verde con letras negras */
    .container-fluid.p-4 .btn-primary {
        background: #A8E063 !important;
        color: #000 !important;
        border: none !important;
        border-radius: 8px;
        font-weight: 700;
    }

        .container-fluid.p-4 .btn-primary:hover {
            filter: brightness(.95);
            color: #000 !important;
        }

    /* Badges (opcional, para coherencia de tonos) */
    .container-fluid.p-4 .badge.bg-success {
        background: #43A047 !important;
    }

    .container-fluid.p-4 .badge.bg-secondary {
        background: #6c757d !important;
    }
</style>


<div class="container-fluid p-4" style="min-height: 100vh; background: rgba(0, 0, 0, 0.85); color: #F1E0C6;">
    <div class="card shadow-lg mb-4" style="background: rgba(0,0,0,0.75); border-radius: 15px;">

        <!-- Encabezado -->
        <div class="card-header text-center" style="background-color: #1A73E8; color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <!-- Cuerpo -->
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">

            @if (TempData["MensajeExito"] != null)
            {
                <div class="alert alert-success text-center fw-bold">@TempData["MensajeExito"]</div>
            }

            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered align-middle">
                    <thead class="table-light text-dark" style="font-family: Raleway;">
                        <tr>
                            <th>#</th>
                            <th>Monto</th>
                            <th>Saldo Pendiente</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody style="font-family: Roboto;">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id_NotaCredito</td>
                                <td>@item.MontoOtorgado.ToString("C")</td>
                                <td>@item.SaldoPendiente.ToString("C")</td>
                                <td>@item.FechaOtorgado.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Estado == "A")
                                    {
                                        <span class="badge bg-success px-3 py-2">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">Cancelado</span>
                                    }
                                </td>
                                <td>
                                    @if (item.SaldoPendiente > 0 && item.Estado == "A")
                                    {
                                        @Html.ActionLink("Pagar", "PagarCredito", new { id = item.Id_NotaCredito }, new { @class = "btn btn-primary btn-sm fw-bold" })
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin acciones</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>