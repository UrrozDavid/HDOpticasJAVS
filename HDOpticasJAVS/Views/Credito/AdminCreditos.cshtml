@model IEnumerable<HDOpticasJAVS.Models.CreditoAdminViewModel>

@{
    ViewBag.Title = "Administración de Créditos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ====== Contenedor de esta pantalla (sin tocar tu HTML) ====== */
    .container.d-flex.align-items-center > .card {
        background: #1f1f1f !important;
        color: #F1E0C6 !important;
        border: 1px solid #2c2c2c !important;
        border-radius: 15px !important;
        box-shadow: 0 12px 24px rgba(0,0,0,.25);
    }

        /* Header verde y tipografía en negro bold (override al inline style) */
        .container.d-flex.align-items-center > .card > .card-header {
            background: #A8E063 !important;
            color: #000 !important;
            border-top-left-radius: 15px !important;
            border-top-right-radius: 15px !important;
            text-align: center;
        }

            .container.d-flex.align-items-center > .card > .card-header h2 {
                margin: 0;
                color: #000 !important;
                font-weight: 800 !important;
                text-shadow: none !important;
            }

    /* Tabla */
    .container.d-flex.align-items-center .table {
        border-color: #2c2c2c;
    }

        .container.d-flex.align-items-center .table thead th {
            background: #f8f9fa !important; /* encabezado claro */
            color: #000 !important;
            border-color: #2c2c2c !important;
        }

        .container.d-flex.align-items-center .table.table-dark tbody td,
        .container.d-flex.align-items-center .table.table-dark tbody th {
            background: #1f1f1f !important;
            color: #F1E0C6 !important;
            border-color: #2c2c2c !important;
        }

    .container.d-flex.align-items-center .table-hover tbody tr:hover {
        background: #242424 !important;
    }

    /* Badges de estado */
    .badge.bg-success {
        background: #28a745 !important;
    }

    .badge.bg-secondary {
        background: #6c757d !important;
    }

    /* Botones */
    .btn-warning.btn-sm,
    .btn-danger.btn-sm {
        font-weight: 700 !important;
        border-radius: 8px !important;
        border: none !important;
    }

    .btn-warning.btn-sm {
        background: #ffc107 !important;
        color: #000 !important;
    }

        .btn-warning.btn-sm:hover {
            filter: brightness(.95);
        }

    .btn-danger.btn-sm {
        background: #dc3545 !important;
    }

        .btn-danger.btn-sm:hover {
            filter: brightness(.95);
        }

    /* Alert de éxito consistente */
    .alert.alert-success {
        background: rgba(40,167,69,.15);
        border: 1px solid rgba(40,167,69,.35);
        color: #d4edda;
    }
    .container.d-flex.align-items-center .table .btn-warning.btn-sm,
    .container.d-flex.align-items-center .table .btn-danger.btn-sm {
        background: #A8E063 !important; /* verde */
        color: #000 !important; /* texto negro */
        border-color: #A8E063 !important;
        border: none !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
    }

        .container.d-flex.align-items-center .table .btn-warning.btn-sm:hover,
        .container.d-flex.align-items-center .table .btn-danger.btn-sm:hover {
            filter: brightness(.95);
        }

        .container.d-flex.align-items-center .table .btn-warning.btn-sm:focus,
        .container.d-flex.align-items-center .table .btn-danger.btn-sm:focus {
            box-shadow: 0 0 0 .2rem rgba(168,224,99,.35) !important;
        }
</style>


<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 2400px; background: rgba(0, 0, 0, 0.75); color: #F1E0C6; border-radius: 15px;">

        <div class="card-header text-center" style="background-color: #1A73E8; color: white; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family: 'Roboto', sans-serif;">
            @if (TempData["MensajeExito"] != null)
            {
                <div class="alert alert-success text-center fw-bold">@TempData["MensajeExito"]</div>
            }

            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered">
                    <thead class="table-light text-dark" style="font-family: Raleway;">
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Nombre Completo</th>
                            <th>Monto</th>
                            <th>Saldo</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody style="font-family: Roboto;">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id_NotaCredito</td>
                                <td>@item.Cedula_Cliente</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.MontoOtorgado.ToString("C")</td>
                                <td>@item.SaldoPendiente.ToString("C")</td>
                                <td>@item.FechaOtorgado.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Estado == "A")
                                    {
                                        <span class="badge bg-success px-3 py-2">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">Cancelado</span>
                                    }
                                </td>
                                <td>
                                    @Html.ActionLink("Editar", "EditarCredito", new { id = item.Id_NotaCredito }, new { @class = "btn btn-warning btn-sm me-2 fw-bold" })
                                    @Html.ActionLink("Cancelar", "CancelarCredito", new { id = item.Id_NotaCredito }, new { @class = "btn btn-danger btn-sm fw-bold" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>