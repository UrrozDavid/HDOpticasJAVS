@model List<HDOpticasJAVS.Models.EmpleadoViewModel>
@{
    ViewBag.Title = "Informe de Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #empleado-informe .card {
        background: #111 !important;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 20px;
        color: #F1E0C6;
    }

    #empleado-informe .card-header {
        background: #A8E063 !important;
        color: #000 !important;
        border: none !important;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    #empleado-informe .form-control {
        background: #1a1a1a !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,.2) !important;
        height: 44px;
        border-radius: 10px;
    }

    #empleado-informe .btn {
        height: 44px;
        border-radius: 10px;
        font-weight: 600;
    }

    #empleado-informe .btn-success {
        background: #A8E063 !important;
        border-color: #A8E063 !important;
        color: #000 !important;
    }

        #empleado-informe .btn-success:hover {
            background: #91cc56 !important;
            border-color: #91cc56 !important;
        }

    #empleado-informe .btn-danger {
        background: #A8E063 !important;
        border-color: #A8E063 !important;
        color: #000 !important;
    }

        #empleado-informe .btn-danger:hover {
            background: #91cc56 !important;
            border-color: #91cc56 !important;
        }

    #empleado-informe .table-dark > :not(caption) > * > * {
        background: #15191d !important;
        color: #e6e6e6 !important;
        border-color: rgba(255,255,255,.08) !important;
    }

    #empleado-informe .table-dark.table-hover tbody tr:hover > td {
        background: #22272c !important;
        color: #fff !important;
    }

    #empleado-informe .badge.bg-success {
        background: #2ecc71 !important;
    }

    #empleado-informe .badge.bg-danger {
        background: #e74c3c !important;
    }

    #empleado-informe .badge.bg-secondary {
        background: #6c757d !important;
    }
</style>

<div id="empleado-informe" class="container" style="min-height:80vh;">
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h2 class="fw-bold" style="font-family:'Poppins',sans-serif;">@ViewBag.Title</h2>
        </div>

        <div class="card-body" style="font-family:'Roboto',sans-serif;">
            @using (Html.BeginForm("Informe", "Empleado", FormMethod.Get))
            {
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-3">
                        <input type="text" name="rol" value="@ViewBag.Rol" class="form-control" placeholder="Rol" />
                    </div>
                    <div class="col-12 col-md-3">
                        <select name="estado" class="form-control">
                            <option value="">Todos los Estados</option>
                            <option value="A" @(ViewBag.Estado == "A" ? "selected" : "")>Activo</option>
                            <option value="I" @(ViewBag.Estado == "I" ? "selected" : "")>Inactivo</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                    </div>
                    <div class="col-12 col-md-3 text-md-end">
                        <div class="d-flex gap-2 justify-content-md-end">
                            <button type="button" class="btn btn-success" onclick="exportarTablaExcel()">
                                <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
                            </button>
                            <button type="button" class="btn btn-danger" onclick="exportarTablaPDF()">
                                <i class="bi bi-file-earmark-pdf"></i> Exportar a PDF
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="table-responsive mt-3">
                <table id="tablaEmpleados" class="table table-dark table-bordered table-hover mb-0">
                    <thead class="table-light text-dark">
                        <tr class="text-center">
                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td>@emp.Cedula</td>
                                <td>@emp.Nombre @emp.Apellido1 @emp.Apellido2</td>
                                <td>@emp.Correo</td>
                                <td>@emp.Rol</td>
                                <td class="text-center">
                                    @if (emp.Estado == "A")
                                    {<span class="badge bg-success">Activo</span> }
                                    else if (emp.Estado == "I")
                                    { <span class="badge bg-danger">Inactivo</span> }
                                    else
                                    { <span class="badge bg-secondary">Desconocido</span>}
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Scripts para exportar -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

<script>
    // Exportar a Excel
    function exportarTablaExcel() {
        const tabla = document.getElementById("tablaEmpleados").cloneNode(true);
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.table_to_sheet(tabla);
        XLSX.utils.book_append_sheet(wb, ws, "Empleados");
        XLSX.writeFile(wb, "Informe_Empleados.xlsx");
    }

    // Exportar a PDF
    async function exportarTablaPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const tablaOriginal = document.getElementById("tablaEmpleados");
        const tablaClonada = tablaOriginal.cloneNode(true);
        doc.setFontSize(14);
        doc.text("Informe de Empleados", 14, 15);
        doc.autoTable({
            html: tablaClonada,
            startY: 25,
            styles: { fontSize: 10 },
            headStyles: { fillColor: [26, 115, 232], textColor: [255, 255, 255] },
            alternateRowStyles: { fillColor: [240, 240, 240] }
        });
        doc.save("Informe_Empleados.pdf");
    }
</script>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
