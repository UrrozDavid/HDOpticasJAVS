@model List<HDOpticasJAVS.Models.EmpleadoViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Informe de Empleados</title>
    <style>
        body {
            font-family: "Segoe UI", sans-serif;
            font-size: 12px;
            color: #fff;
            background-color: #111;
            margin: 0;
            padding: 20px;
        }

        h2 {
            font-family: "Poppins", sans-serif;
            font-size: 20px;
            background-color: #A8E063;
            color: #000;
            padding: 10px;
            text-align: center;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        th, td {
            border: 1px solid #444;
            padding: 6px;
            text-align: center;
        }

        thead th {
            background-color: #1f1f1f;
            color: #ddd;
        }

        tbody tr:nth-child(even) {
            background-color: #15191d;
        }

        tbody tr:nth-child(odd) {
            background-color: #1b1f23;
        }

        .estado-activo {
            color: #000;
            background: #A8E063;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            display: inline-block;
        }

        .estado-inactivo {
            color: #fff;
            background: #e74c3c;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            display: inline-block;
        }
    </style>
</head>
<body>

    <h2>Informe de Empleados</h2>

    <table>
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre Completo</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Cedula</td>
                    <td>@emp.Nombre @emp.Apellido1 @emp.Apellido2</td>
                    <td>@emp.Correo</td>
                    <td>@emp.Rol</td>
                    <td>
                        @if (emp.Estado == "A")
                        {
                            <span class="estado-activo">Activo</span>
                        }
                        else
                        {
                            <span class="estado-inactivo">Inactivo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>
