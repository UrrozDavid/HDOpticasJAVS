@{
    ViewBag.Title = "Eliminar empleado";
}

<style>
    /* ====== Card y header ====== */
    #empleado-eliminar .card {
        background: #111 !important;
        border: 1px solid rgba(255,255,255,0.08);
    }

    #empleado-eliminar .card-header {
        background-color: #A8E063 !important;
        color: #000 !important;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

        #empleado-eliminar .card-header h2 {
            margin: 0;
            font-family: 'Poppins', sans-serif;
        }

    /* ====== Texto ====== */
    #empleado-eliminar p {
        color: #fff;
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
    }

    /* ====== Botones ====== */
    #empleado-eliminar .btn-danger {
        background-color: #E74C3C !important;
        border-color: #E74C3C !important;
        color: #fff !important;
        font-weight: 600;
    }

        #empleado-eliminar .btn-danger:hover {
            background-color: #c94032 !important;
            border-color: #c94032 !important;
        }

    #empleado-eliminar .btn-secondary {
        background-color: #444 !important;
        border-color: #444 !important;
        color: #fff !important;
    }

        #empleado-eliminar .btn-secondary:hover {
            background-color: #555 !important;
            border-color: #555 !important;
        }
</style>


<h2>@ViewBag.Title</h2>

<div id="empleado-eliminar" class="container d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow-lg" style="max-width: 600px; width: 100%; background: #111; color: #F1E0C6; border-radius: 15px;">
        <div class="card-header text-center">
            <h2 class="fw-bold">@ViewBag.Title</h2>
        </div>
        <div class="card-body text-center">
            <p>¿Está seguro de que desea eliminar este empleado?</p>
            <form method="post">
                <button type="submit" class="btn btn-danger me-2">Eliminar</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
