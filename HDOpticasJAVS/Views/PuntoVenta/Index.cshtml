@{
    ViewBag.Title = "Punto de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card-body">
    <div class="row">
        <div class="col-md-6">
            <h4 style="color: #00B5E2;">Seleccionar Producto</h4>
            <input type="text" id="buscarProducto" class="form-control mb-3" placeholder="Buscar producto...">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered" id="tablaProductos">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Agregar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ViewBag.Productos)
                        {
                            <tr>
                                <td>@p.Nombre_Producto</td>
                                <td>₡@p.Precio</td>
                                <td>
                                    <button class="btn btn-sm btn-success" onclick="agregarProducto(@p.Id_Producto, '@p.Nombre_Producto', @p.Precio)">+</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-6">
            <h4 style="color: #FF7043;">Detalles de la Compra</h4>
            <ul id="detalleCompra" class="list-group mb-3"></ul>
            <h5 class="text-end text-danger" id="totalFinal">Total: ₡0.00</h5>

            <label>Método de Pago:</label>
            <select id="metodoPago" class="form-select mb-2">
                @foreach (var metodo in ViewBag.MetodosPago)
                {
                    <option value="@metodo.Id_Parametro">@metodo.Nombre_Parametro</option>
                }
            </select>

            <label>Cédula Cliente:</label>
            <input type="text" id="cedulaCliente" class="form-control mb-3">

            <button class="btn btn-primary w-100" onclick="procesarPago()">Procesar Pago</button>
        </div>
    </div>
</div>

<script>
    let carrito = [];

    function agregarProducto(id, nombre, precio) {
        carrito.push({ id, nombre, precio });
        actualizarVista();
    }

    function actualizarVista() {
        let total = 0;
        let html = "";
        carrito.forEach(p => {
            total += p.precio;
            html += `<li class="list-group-item d-flex justify-content-between">
                        <span>${p.nombre}</span>
                        <span>₡${p.precio.toFixed(2)}</span>
                    </li>`;
        });
        document.getElementById("detalleCompra").innerHTML = html;
        document.getElementById("totalFinal").innerText = `Total: ₡${total.toFixed(2)}`;
    }

    function procesarPago() {
        if (carrito.length === 0) return alert("Agregue al menos un producto.");
        const cliente = document.getElementById("cedulaCliente").value;
        const metodo = document.getElementById("metodoPago").value;

        // Simular petición POST
        alert("Venta procesada correctamente.");
        carrito = [];
        actualizarVista();
    }
</script>