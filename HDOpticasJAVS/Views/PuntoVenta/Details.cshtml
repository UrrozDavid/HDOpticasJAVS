@model HDOpticasJAVS.PuntoVenta

@{
    ViewBag.Title = "Detalles de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg w-100" style="max-width: 1000px; background: rgba(0, 0, 0, 0.85); color: #F1E0C6; border-radius: 15px;">
        <div class="card-header text-center" style="background-color: #1A73E8; color: white;">
            <h2 class="fw-bold" style="font-family: 'Poppins', sans-serif;">@ViewBag.Title</h2>
        </div>
        <div class="card-body" style="font-family: 'Roboto', sans-serif;">

            <dl class="row">
                <dt class="col-sm-4">Cliente</dt>
                <dd class="col-sm-8">
                    @Model.Cliente.Usuario.Nombre @Model.Cliente.Usuario.Apellido1 @Model.Cliente.Usuario.Apellido2
                </dd>

                <dt class="col-sm-4">Método de Pago</dt>
                <dd class="col-sm-8">@Model.Parametro.Nombre_Parametro</dd>

                <dt class="col-sm-4">Fecha</dt>
                <dd class="col-sm-8">@($"{Model.Fecha_Venta:dd/MM/yyyy}")</dd>

                <dt class="col-sm-4">Hora</dt>
                <dd class="col-sm-8">@Model.Hora_Venta</dd>
            </dl>

            <hr />
            <h5 class="text-white">Detalle de Productos</h5>
            <table class="table table-dark table-bordered">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio Unitario</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model.DetalleVenta)
                    {
                        <tr>
                            <td>@detalle.Inventario.Nombre_Producto</td>
                            <td>₡@(detalle.PrecioUnitario?.ToString("N2") ?? "0.00")</td>
                            <td>@detalle.Cantidad</td>
                            <td>₡@(detalle.Subtotal?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row text-end">
                <div class="col-sm-12">
                    <p><strong>Subtotal:</strong> ₡@(Model.Subtotal?.ToString("N2") ?? "0.00")</p>
                    <p><strong>IVA (13%):</strong> ₡@(Model.IVA?.ToString("N2") ?? "0.00")</p>
                    <p><strong>Total:</strong> ₡@(Model.Total?.ToString("N2") ?? "0.00")</p>
                </div>

                <div class="text-end">
                    <a href="@Url.Action("AplicarPromocion", "Marketing", new { idVenta = Model.Id_Venta })"
                       class="btn btn-outline-warning me-2">
                        <i class="bi bi-ticket-perforated"></i> Aplicar Promoción
                    </a>
                    <a href="@Url.Action("Edit", new { id = Model.Id_Venta })" class="btn btn-warning">Editar</a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
                </div>

            </div>
        </div>
    </div>
</div>