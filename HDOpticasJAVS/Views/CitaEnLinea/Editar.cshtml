@model HDOpticasJAVS.Cita

@{
    ViewBag.Title = "Editar Cita";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container">
    <h2 class="text-white">@ViewBag.Title</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id_Cita)
        @Html.HiddenFor(model => model.Cedula_Usuario)
        @Html.HiddenFor(model => model.Id_EstadoCita)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Fecha de Cita</label>
                @Html.TextBoxFor(model => model.Fecha_Cita, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                @Html.ValidationMessageFor(model => model.Fecha_Cita, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <label>Hora de Cita</label>
                @Html.TextBoxFor(model => model.Hora_Cita, "{0:hh\\:mm}", new { @class = "form-control", @type = "time" })
                @Html.ValidationMessageFor(model => model.Hora_Cita, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Tipo de Especialista</label>
                @Html.DropDownList("Id_TipoEspecialista", ViewBag.Especialidades as SelectList, "-- Seleccionar --", new { @class = "form-select", @id = "ddlEspecialidadAdmin" })
            </div>
            <div class="col-md-6">
                <label>Especialista</label>
                <select id="ddlEspecialistaAdmin" name="Cedula_Especialista" class="form-select" required>
                    <option value="">-- Seleccionar --</option>
                </select>
            </div>
        </div>


        <div class="col-12 text-end mt-3">
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("Calendario", "CitaEnLinea")" class="btn btn-secondary me-2">Volver</a>
        </div>

    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ddlEspecialidadAdmin').change(function () {
                var idEspecialidad = $(this).val();
                console.log("Especialidad seleccionada:", idEspecialidad);

                if (idEspecialidad) {
                    $.getJSON('@Url.Action("ObtenerEspecialistas", "CitaEnLinea")',
                        { idEspecialidad: idEspecialidad },
                        function (data) {
                            console.log("Especialistas recibidos:", data);
                            var ddl = $('#ddlEspecialistaAdmin');
                            ddl.empty();
                            ddl.append($('<option>').text('-- Seleccione un especialista --').attr('value', ''));
                            $.each(data, function (i, item) {
                                ddl.append($('<option>').text(item.NombreCompleto).attr('value', item.Cedula));
                            });
                        }).fail(function (jqXHR, textStatus, errorThrown) {
                            console.error("Error en la petición AJAX:", textStatus, errorThrown);
                        });
                } else {
                    $('#ddlEspecialistaAdmin').empty().append($('<option>').text('-- Seleccione un especialista --').attr('value', ''));
                }
            });
        });
    </script>
}