@{
    ViewBag.Title = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 450px; background-color: #1e1e1e; border-radius: 15px;">
        <div class="card-header text-white text-center" style="background-color: #A8E063; border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h3 class="mb-0" style="font-family: 'Poppins', sans-serif; color:black">Recuperar Contraseña</h3>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
        {
            <div class="alert alert-info mt-3">@ViewBag.Mensaje</div>
        }

        <form method="post" action="@Url.Action("Recuperar", "Account")" class="mt-4">
            <div class="form-group mb-3">
                <label for="email" class="text-white">Correo Electrónico</label>
                <input type="email" class="form-control" id="email" name="email" required placeholder="ejemplo@correo.com" />
            </div>

            <button type="submit" class="btn btn-verde w-100">Enviar Enlace</button>
        </form>

        <div class="text-center mt-3">
            <a href="@Url.Action("Login", "Account")" style="color: white;">Volver al inicio de sesión</a>
        </div>
    </div>
</div>

<style>
    .btn-verde {
        background-color: #A8E063;
        border-color: #A8E063;
        color: black;
        font-weight: bold;
        font-family: "Poppins", sans-serif;
    }

        .btn-verde:hover {
            background-color: #8FC44C;
            border-color: #8FC44C;
            color: white;
        }

    .form-control {
        background-color: #333;
        border: 1px solid #666;
        color: white;
    }

        .form-control::placeholder {
            color: #bbb;
        }

    label {
        font-family: "Raleway", sans-serif;
        font-size: 1rem;
    }

    .alert-info {
        background-color: #263238;
        border-color: #37474F;
        color: #A8E063;
        font-family: "Roboto", sans-serif;
    }

    a.text-success {
        font-family: "Poppins", sans-serif;
    }
</style>
