@model IEnumerable<HDOpticasJAVS.Contabilidad>

@{
    ViewBag.Title = "Contabilidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ===== Header verde centrado ===== */
    .k-header {
        max-width: 1100px;
        margin: 20px auto 0;
        background: #A8E063;
        color: #000;
        border-radius: 15px 15px 0 0;
        padding: 14px 20px;
        font-weight: 800;
        text-align: center
    }

        .k-header h2 {
            margin: 0
        }

    /* ===== Card oscuro pegado al header ===== */
    .k-card {
        max-width: 1100px;
        margin: 0 auto 24px;
        background: #1f1f1f;
        color: #F1E0C6;
        border: 1px solid #2c2c2c;
        border-top: 0;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 12px 24px rgba(0,0,0,.25);
        padding: 20px
    }

    /* Alerts alineadas al ancho */
    .k-alert {
        max-width: 1100px;
        margin: 10px auto
    }

    /* Botones */
    .btn-success {
        background: #A8E063 !important;
        color: #000 !important;
        border: none !important;
        font-weight: 700;
        border-radius: 8px
    }

        .btn-success:hover {
            filter: brightness(.95)
        }

    .btn-outline-success {
        color: #A8E063;
        border-color: #A8E063;
        border-radius: 8px;
        font-weight: 600
    }

        .btn-outline-success:hover {
            background: #A8E063;
            color: #000
        }

    /* Dropdown compacto */
    .btn-group .btn.dropdown-toggle {
        padding: .25rem .6rem;
        border-radius: 8px
    }

    .dropdown-menu-dark {
        --bs-dropdown-link-active-bg: #2e2e2e
            }
    
    .k-header {
        color: #000 !important;
    }

        .k-header h2,
        .k-header h2 * {
            color: #000 !important;
            font-weight: 800 !important; 
            text-shadow: none !important;
        }

</style>

@if (TempData["SuccessMessage"] != null || TempData["MensajeExito"] != null)
{
    var mensaje = TempData["SuccessMessage"] ?? TempData["MensajeExito"];
    <div class="alert alert-success alert-dismissible fade show k-alert" role="alert">
        <strong>¡Éxito!</strong> @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show k-alert" role="alert">
        <strong>Error:</strong> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="k-header">
    <h2>@ViewBag.Title</h2>
</div>

<!-- Filtro por cédula (en card) -->
@using (Html.BeginForm("Index", "Contabilidad", FormMethod.Get))
{
    <div class="k-card pt-3">
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="usuarioFiltro" class="form-label fw-bold text-light">Filtrar por Cédula</label>
                @Html.DropDownList("usuarioFiltro", (SelectList)ViewBag.UsuarioFiltro, "Todos", new { @class = "form-select", onchange = "this.form.submit();" })
            </div>
        </div>
    </div>
}

@{
    var parametros = ViewBag.Parametros as Dictionary<int, string>;
}

<div class="k-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="@Url.Action("ReporteEgresosPorCategoria","Contabilidad")" class="btn btn-outline-success">
            📊 Reporte de Egresos por Categoría
        </a>
        @Html.ActionLink("Crear Nuevo Registro", "Create", null, new { @class = "btn btn-success" })
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover table-bordered align-middle text-center mb-0">
            <thead class="table-light text-dark" style="font-family: Raleway;">
                <tr>
                    <th>Id</th>
                    <th>Venta</th>
                    <th>Producto</th>
                    <th>Cant.</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                    <th>Descuento</th>
                    <th>IVA</th>
                    <th>Total</th>
                    <th>Fecha de Registro</th>
                    <th>Usuario Registro</th>
                    <th>Tipo Movimiento</th>
                    <th>Estado</th>
                    <th>Usuario Creador</th>
                    <th>Fecha de Creación</th>
                    <th>Usuario Modidicado</th>
                    <th>Fecha de Modificación</th>
                    <th>Tipo Operación</th>
                    <th>Tipo Servicio</th>
                    <th>Ingreso/Egreso</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id_Contabilidad</td>
                        <td>@item.Id_Venta</td>
                        <td>@(item.Inventario != null ? item.Inventario.Nombre_Producto : "N/A")</td>
                        <td>@item.Cantidad</td>
                        <td>@string.Format("{0:C}", item.PrecioUnitario)</td>
                        <td>@string.Format("{0:C}", item.Subtotal)</td>
                        <td>@string.Format("{0:C}", item.Descuento)</td>
                        <td>@string.Format("{0:C}", item.IVA)</td>
                        <td>@string.Format("{0:C}", item.Total)</td>
                        <td>@item.Fecha_Registro</td>
                        <td>@item.Usuario_Registro</td>
                        <td>
                            @{
                                if (parametros != null && item.Id_TipoMovimiento.HasValue && parametros.ContainsKey(item.Id_TipoMovimiento.Value))
                                {
                                    @parametros[item.Id_TipoMovimiento.Value]
                                }
                                else
                                {
                                    @:Sin categoría
                                }
                            }
                        </td>
                        <td>@item.Estado</td>
                        <td>@item.UsuarioCreador</td>
                        <td>@item.FechaCreacion</td>
                        <td>@item.UsuarioModificador</td>
                        <td>@item.FechaModificacion</td>
                        <td>@item.TipoOperacion</td>
                        <td>@item.TipoServicio</td>
                        <td>@item.TipoMovimientoIngresoEgreso</td>

                        <!-- Dropdown de acciones -->
                        <td class="text-center">
                            <div class="btn-group">
                                <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    Opciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Details", "Contabilidad", new { id = item.Id_Contabilidad })">
                                            <i class="bi bi-eye me-2"></i>Ver
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Edit", "Contabilidad", new { id = item.Id_Contabilidad })">
                                            <i class="bi bi-pencil me-2"></i>Editar
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        @using (Html.BeginForm("Delete", "Contabilidad", FormMethod.Post, new { onsubmit = "return confirm('¿Desea eliminar este registro?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", item.Id_Contabilidad)
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-trash me-2"></i>Eliminar
                                            </button>
                                        }
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">Totales:</td>
                    <td>@string.Format("{0:C}", ViewBag.TotalSubtotal ?? 0)</td>
                    <td></td>
                    <td></td>
                    <td>@string.Format("{0:C}", ViewBag.TotalTotal ?? 0)</td>
                    <td colspan="11"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Icons para el dropdown -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
